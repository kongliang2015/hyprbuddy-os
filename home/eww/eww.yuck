;; eww 弹窗：日历 + 会话面板
;; 由 theme-next 写 ~/.config/eww/eww.scss 的配色；本文件只管结构。

(defwidget cal-box []
  (box :class "card" :orientation "vertical" :space-evenly false
    (label :class "card-title" :text "日历")
    (calendar :class "cal")
    (button :class "card-btn" :onclick "eww close calendar" "关闭")))

(defwindow calendar
  :geometry (geometry :x "0%" :y "46px" :width "340px" :height "300px" :anchor "top center")
  :stacking "overlay"
  :namespace "eww-calendar"
  :exclusive false
  :focusable true
  (cal-box))

(defwidget sess-box []
  (box :class "card" :orientation "vertical" :space-evenly false
    (label :class "card-title" :text "会话")
    (box :orientation "horizontal" :space-evenly true
      (button :class "card-btn" :onclick "eww close session; hyprlock" "锁屏")
      (button :class "card-btn" :onclick "eww close session; hyprctl dispatch exit" "注销")
      (button :class "card-btn" :onclick "eww close session; systemctl reboot" "重启")
      (button :class "card-btn" :onclick "eww close session; systemctl poweroff" "关机"))
    (box :orientation "horizontal" :space-evenly true
      (button :class "card-btn" :onclick "eww close session" "取消"))))

(defwindow session
  :geometry (geometry :x "0%" :y "0%" :width "520px" :height "110px" :anchor "center")
  :stacking "overlay"
  :namespace "eww-session"
  :exclusive false
  :focusable true
  (sess-box))
