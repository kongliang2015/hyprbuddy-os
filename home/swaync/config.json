{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 44,
  "control-center-margin-right": 10,
  "control-center-margin-bottom": 0,
  "control-center-margin-left": 0,
  "notification-window-width": 380,
  "control-center-width": 380,
  "control-center-height": 620,
  "fit-to-screen": false,
  "transition-time": 200,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "notification-icon-size": 40,
  "notification-body-image-height": 100,
  "notification-body-image-width": 200,
  "notification-grouping": true,
  "relative-timestamps": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "widgets": [ "title", "dnd", "mpris", "volume", "notifications" ],
  "widget-config": {
    "title": { "text": "通知", "clear-all-button": true, "button-text": "全部清除" },
    "dnd": { "text": "免打扰" },
    "mpris": { "image-size": 96, "image-radius": 8 },
    "volume": { "label": "音量" },
    "notifications": { "vexpand": true }
  }
}
