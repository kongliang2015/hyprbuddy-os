// niri 基线配置（随 install.sh 部署到 ~/.config/niri/config.kdl）
// 键位尽量与 docs/KEYBINDS.md 的 Hyprland 表对齐；运行期可自行修改（install.sh 会覆盖）。
// 依赖：kitty / noctalia-shell；fuzzel 只用于 dmenu 管道（剪贴板历史），不再作启动器。

// 自启：外壳（面板/launcher/通知/锁屏）与壁纸守护
// noctalia 必须等显示器就绪后再起：niri 会先跑 spawn、约 0.5s 后才接上 DRM 输出，
// 抢在输出之前启动时它拿不到 screen，bar 永远不会创建（实测 2026-10-28）。
// 同时把 stdout/stderr 落到 ~/.cache，便于登录后排查。
spawn-at-startup "sh" "-c" "sleep 2; exec noctalia-shell >>\"$HOME/.cache/noctalia-shell.log\" 2>&1"
// 剪贴板历史：cliphist 只负责存储，需要 watcher 持续喂数据（text + image 两路）
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"
// 登录后应用已保存主题：等 Noctalia 起来（sleep 5）再跑，否则 IPC 找不到实例。
// theme-next restore 读 ~/.local/state/theme-next/idx，niri 分支 → exporters/niri/theme.sh。
spawn-at-startup "sh" "-c" "sleep 5; exec theme-next restore >>\"$HOME/.cache/theme-next.log\" 2>&1"

input {
    keyboard {
        xkb { layout "us"; }
    }
    touchpad {
        tap
        natural-scroll
    }
    workspace-auto-back-and-forth
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }
}

// 单显示器默认全屏铺满（与 Hyprland 的 monitor=,preferred 一致）
output "eDP-1" {
    scale 1.0;
}

binds {
    // 终端 / 启动器 / 系统菜单
    Mod+Return { spawn "kitty"; }
    Mod+D      { spawn "noctalia-shell" "ipc" "call" "launcher" "toggle"; }

    // 窗口
    Mod+Q          { close-window; }
    Mod+F          { fullscreen-window; }
    Mod+Shift+F    { toggle-window-floating; }
    Mod+Shift+E    { quit; }

    // 列/窗口导航（滚动平铺）
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // 工作区
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }

    // 系统面板（Noctalia IPC）
    Mod+Shift+C { spawn "noctalia-shell" "ipc" "call" "controlCenter" "toggle"; }
    Mod+Shift+P { spawn "noctalia-shell" "ipc" "call" "sessionMenu" "toggle"; }
    Mod+Shift+S { spawn "noctalia-shell" "ipc" "call" "settings" "toggle"; }

    // 媒体键（niri 不内置硬件键处理，必须显式绑定）
    // 走 Noctalia IPC，OSD 才会跟随显示（wpctl/brightnessctl 直连没有 OSD）
    XF86AudioRaiseVolume  { spawn "noctalia-shell" "ipc" "call" "volume" "increase"; }
    XF86AudioLowerVolume  { spawn "noctalia-shell" "ipc" "call" "volume" "decrease"; }
    XF86AudioMute         { spawn "noctalia-shell" "ipc" "call" "volume" "muteOutput"; }
    XF86AudioMicMute      { spawn "noctalia-shell" "ipc" "call" "volume" "muteInput"; }
    XF86MonBrightnessUp   { spawn "noctalia-shell" "ipc" "call" "brightness" "increase"; }
    XF86MonBrightnessDown { spawn "noctalia-shell" "ipc" "call" "brightness" "decrease"; }
    XF86AudioPlay         { spawn "playerctl" "play-pause"; }
    XF86AudioNext         { spawn "playerctl" "next"; }
    XF86AudioPrev         { spawn "playerctl" "previous"; }

    // 剪贴板历史
    Mod+V        { spawn "clipboard-menu"; }

    // 锁屏 / 主题 / 截图
    Mod+L        { spawn "loginctl" "lock-session"; }
    Mod+Shift+T  { spawn "theme-picker"; }
    Print        { screenshot-screen; }
    Mod+Shift+A  { screenshot-window; }
}

// 浮动窗口（设置类工具）
window-rule {
    match app-id=r#"pavucontrol"#;
    open-floating true
}
window-rule {
    match app-id=r#"nm-connection-editor"#;
    open-floating true
}
