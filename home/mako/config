# mako 通知 — elarun 统一风格
font=JetBrainsMono Nerd Font 10
background-color=#0f2438f2
text-color=#d7e7f5
border-color=#0e7fa8
border-size=2
border-radius=12
progress-color=#1e9bd8cc
padding=12
margin=10
width=380
# 0 = 自动高度；400 为 15 行封顶，避免超长内容顶出屏幕（原 120 只够 4~5 行，会硬裁）
height=400
max-visible=4
default-timeout=8000
ignore-timeout=0
anchor=top-right
layer=overlay
# 不按 app-name 折叠（折叠会把同应用多条通知压成一条，只显示最新)
sort=-time
icons=1
max-icon-size=48
icon-border-radius=8
icon-path=/run/current-system/sw/share/icons/hicolor
markup=1
actions=1
text-alignment=left
format=<b>%s</b>\n%b

# 低优先级：更短、灰边
[urgency=low]
border-color=#4a5e72
default-timeout=3000

# 紧急通知：红色边框，常驻直到手动关闭
[urgency=critical]
border-color=#c04a55
default-timeout=0

# 勿扰模式：makoctl mode -t dnd 切换
[mode=dnd]
invisible=1

# kitty 转发的终端协议通知（codebuddy 走 OSC 99/777）：appname 为 kitty，
# 图标在左侧垂直居中会把正文挤到右侧造成错位，这里只对该应用关闭图标。
[app-name=kitty]
icons=0
