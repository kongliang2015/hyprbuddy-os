# mako 通知 — Kanagawa 统一风格
font=JetBrainsMono Nerd Font 10
background-color=#1f1f28f2
text-color=#dcd7ba
border-color=#7e9cd8
border-size=2
border-radius=12
progress-color=#7e9cd8cc
padding=12
margin=10
width=380
height=120
max-visible=4
default-timeout=5000
ignore-timeout=0
anchor=top-right
layer=overlay
group-by=app-name
sort=-time
icons=1
max-icon-size=48
icon-border-radius=8
icon-path=/run/current-system/sw/share/icons/hicolor
markup=1
actions=1
text-alignment=left
format=<b>%s</b>\n%b

# 低优先级：更短、灰边
[urgency=low]
border-color=#727169
default-timeout=3000

# 紧急通知：红色边框，常驻直到手动关闭
[urgency=critical]
border-color=#c34043
default-timeout=0

# 勿扰模式：makoctl mode -t dnd 切换
[mode=dnd]
invisible=1
