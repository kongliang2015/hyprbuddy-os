# mako 通知 — elarun 统一风格
font=JetBrainsMono Nerd Font 10
# 以下颜色只是首启兜底值，theme-next 每次切换都会按当前主题重算整组色阶：
# 卡片底 = 主题底色提亮 6%（近白）、描边 = 底×强调色 30% 的柔边，避免"黑底亮线"。
background-color=#1c1b22e6
text-color=#e4e2ea
border-color=#3a3a46b3
# 1px 柔边 + 大圆角，配合 notifications 层的 blur 做磨砂卡片感（mako 无阴影能力）
border-size=1
border-radius=14
progress-color=#8a8fa8cc
padding=16
margin=10
width=380
# 0 = 自动高度；400 为 15 行封顶，避免超长内容顶出屏幕（原 120 只够 4~5 行，会硬裁）
height=400
max-visible=4
default-timeout=8000
ignore-timeout=0
anchor=top-right
layer=overlay
# 不按 app-name 折叠（折叠会把同应用多条通知压成一条，只显示最新)
sort=-time
icons=1
max-icon-size=36
icon-border-radius=8
icon-path=/run/current-system/sw/share/icons/hicolor
markup=1
actions=1
text-alignment=left
# 标题主色加粗，正文用主题次要色（theme-next 会注入 foreground）
format=<b>%s</b>\n<span foreground="#565f89">%b</span>
# 保留历史，可用 makoctl restore 找回
history=1
max-history=10

# 低优先级：更短、灰边、更透明（背景色由 theme-next 注入）
[urgency=low]
background-color=#191820d9
border-color=#33323d99
default-timeout=3000

# 紧急通知：偏红底色 + 饱和一些的柔红边（背景色由 theme-next 注入）
[urgency=critical]
background-color=#241a1ff0
border-color=#8f4b52cc
default-timeout=0

# 勿扰模式：makoctl mode -t dnd 切换
[mode=dnd]
invisible=1

# kitty 转发的终端协议通知（codebuddy 走 OSC 99/777）：appname 为 kitty，
# 图标在左侧垂直居中会把正文挤到右侧造成错位，这里只对该应用关闭图标。
[app-name=kitty]
icons=0
