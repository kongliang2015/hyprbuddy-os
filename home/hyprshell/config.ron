// hyprshell：overview = Super+`，switch = Alt+Tab（本文件由 config generate 产出后精修）
// 由 install.sh 软链到 ~/.config/hyprshell/config.ron
(
    version: 4,
    windows: (
        scale: 10.0,
        items_per_row: 5,
        overview: (
            launcher: (
                default_terminal: None,
                launch_modifier: "ctrl",
                width: 650,
                max_items: 5,
                show_when_empty: true,
                plugins: (
                    applications: (
                        run_cache_weeks: 8,
                        show_execs: true,
                        show_actions_submenu: true,
                    ),
                    terminal: (),
                    shell: None,
                    websearch: None,
                    calc: (),
                    path: (),
                    actions: (
                        actions: [
                            lock_screen,
                            hibernate,
                            logout,
                            reboot,
                            shutdown,
                            suspend,
                            custom(
                                names: [
                                    "Reload Hyprshell",
                                ],
                                details: "Reload Hyprshell",
                                command: "sleep 1; hyprshell socat \'\"Reload\"\'",
                                icon: "system-restart",
                            ),
                        ],
                    ),
                ),
            ),
            key: "grave",
            top_offset: 430,
            modifier: "super",
            filter_by: [],
            exclude_workspaces: "special:.*",
        ),
        switch: (
            modifier: "alt",
            key: "Tab",
            filter_by: [],
            switch_workspaces: false,
            exclude_workspaces: "",
            kill_key: 'q',
        ),
        switch_2: None,
    ),
)