#!/usr/bin/env bash
# @command: model-bench
# @summary: 本地模型基准（idle / 单请求 / 3 路并发的 tok/s、显存与功耗基线）
# @category: check
# @usage: model-bench [--json] [--model <name>]
# @effect: 向本机 ollama 发起推理请求；写入 ~/.local/state/hyprbuddy-os/power-bench.json
# @doc: agent.md
#
# 功耗只取 nvidia-smi 的 GPU power.draw（非整机瓦数）；读不到一律 null，不伪造。
# 三档读数写进 power-bench.json，供 power-status --json 的 power.scenarios 输出。
set -uo pipefail

JQ="@JQ@"
if [ ! -x "$JQ" ]; then JQ="$(command -v jq || true)"; fi

ENDPOINT="http://127.0.0.1:11434"
MODEL="qwen2.5-coder:1.5b"
JSON=0
while [ $# -gt 0 ]; do
  case "$1" in
    --json) JSON=1; shift ;;
    --model) MODEL="${2:?用法: model-bench [--model <name>]}"; shift 2 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# *//'; exit 0 ;;
    *) echo "用法: model-bench [--json] [--model <name>]" >&2; exit 2 ;;
  esac
done

[ -n "$JQ" ] || { echo "错误: 需要 jq" >&2; exit 1; }
command -v curl >/dev/null 2>&1 || { echo "错误: 需要 curl" >&2; exit 1; }
curl -sS --max-time 2 "$ENDPOINT/api/tags" >/dev/null 2>&1 || {
  echo "错误: ollama 端点不可达（先 switch 系统并 ollama pull $MODEL）" >&2; exit 1; }

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/hyprbuddy-os"
bench="$state_dir/power-bench.json"

power_w() {
  local w=""
  if command -v nvidia-smi >/dev/null 2>&1; then
    w=$(nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
    case "$w" in ''|'N/A'|'[N/A]'|'[Not Supported]') w="" ;; esac
  fi
  printf '%s' "${w:-null}"
}

gpu_mem() {
  local m=""
  if command -v nvidia-smi >/dev/null 2>&1; then
    m=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' ')
  fi
  printf '%s' "${m:-null}"
}

# 一次 /api/generate；输出 "<eval_count> <eval_duration_ns>"
one_request() {
  local body
  body=$(curl -sS --max-time 120 "$ENDPOINT/api/generate" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"$MODEL\",\"prompt\":\"Reply with OK\",\"stream\":false}" 2>/dev/null || true)
  if [ -z "$body" ]; then printf '0 0\n'; return 1; fi
  "$JQ" -r '[.eval_count // 0, .eval_duration // 0] | @tsv' <<<"$body" 2>/dev/null || printf '0 0\n'
}

tok_per_s() {
  local c="$1" d="$2"
  if [ "$d" -gt 0 ] 2>/dev/null && [ "$c" -gt 0 ] 2>/dev/null; then
    awk -v c="$c" -v d="$d" 'BEGIN { printf "%.2f", c / (d / 1000000000) }'
  else
    printf 'null'
  fi
}

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# ── idle：无推理负载 ──
sleep 1
idle_w=$(power_w)

# ── single：1 路请求，负载中采样功耗 ──
one_request > "$tmp/single" &
pid=$!
sleep 0.3
single_w=$(power_w)
wait "$pid" 2>/dev/null || true
read -r sc sd < "$tmp/single" 2>/dev/null || true
single_tps=$(tok_per_s "${sc:-0}" "${sd:-0}")

# ── concurrent：3 路并发，负载中采样功耗 ──
for i in 1 2 3; do one_request > "$tmp/r$i" & done
sleep 0.5
concurrent_w=$(power_w)
wait
cc=0; cdn=0
for i in 1 2 3; do
  read -r a b < "$tmp/r$i" 2>/dev/null || true
  cc=$(( cc + ${a:-0} )); cdn=$(( cdn + ${b:-0} ))
done
concurrent_tps=$(tok_per_s "$cc" "$cdn")

mem_w=$(gpu_mem)
power_source='"unavailable"'
[ "$idle_w" != "null" ] && power_source='"nvidia-smi:gpu"'

mkdir -p "$state_dir"
"$JQ" -n -c \
  --arg model "$MODEL" --argjson source "$power_source" \
  --argjson idle "${idle_w:-null}" \
  --argjson single "${single_w:-null}" \
  --argjson concurrent "${concurrent_w:-null}" \
  '{model:$model,power_source:$source,unit:"W",
    scenarios:{idle:$idle,single_request:$single,concurrent:$concurrent},
    note:"GPU power.draw（非整机瓦数）；由 model-bench 采样，未测得为 null"}' > "$bench"

if [ "$JSON" = 1 ]; then
  "$JQ" -n -c \
    --arg model "$MODEL" --argjson source "$power_source" \
    --argjson idle "${idle_w:-null}" --argjson single "${single_w:-null}" --argjson concurrent "${concurrent_w:-null}" \
    --argjson single_tps "${single_tps:-null}" --argjson concurrent_tps "${concurrent_tps:-null}" \
    --argjson mem "${mem_w:-null}" \
    '{model:$model,power_source:$source,unit:"W",gpu_memory_used_mib:$mem,
      tok_per_s:{single_request:$single_tps,concurrent:$concurrent_tps},
      power_w:{idle:$idle,single_request:$single,concurrent:$concurrent}}'
  exit 0
fi

echo "本地模型基准  $(date +%F' '%T)  模型 $MODEL"
echo
if [ "$power_source" = '"unavailable"' ]; then
  echo "功耗来源    不可用（读不到 GPU 功耗，未伪造整机瓦数）"
else
  echo "功耗来源    nvidia-smi:gpu（GPU 功耗，非整机瓦数）"
fi
printf "功耗 idle / 单请求 / 并发    %s / %s / %s W\n" "$idle_w" "$single_w" "$concurrent_w"
printf "tok/s  单请求 / 3 路并发      %s / %s\n" "$single_tps" "$concurrent_tps"
printf "显存占用                      %s MiB\n" "$mem_w"
printf "基线已写入                    %s\n" "$bench"
