#!/usr/bin/env bash
# @command: agent-commands
# @summary: 机器可读命令清单（--json / list / show / --category / workflows / paths）
# @category: check
# @usage: agent-commands [--json | list | show <name> | --category <cat> | workflows | paths [--json]]
# @effect: 只读
# @doc: workflow.md
set -euo pipefail

# 部署时由 home/default.nix 把 @JQ@ 替换为 store 里的 jq 绝对路径；
# 直接运行仓库内脚本时回退到 PATH。
JQ="@JQ@"
if [ ! -x "$JQ" ]; then
  JQ="$(command -v jq || true)"
fi

locate() {
  local f
  for f in "${HOME}/.local/share/hyprbuddy-os/commands.json" "/etc/xdg/hyprbuddy-os/commands.json"; do
    if [ -f "$f" ]; then printf '%s\n' "$f"; return 0; fi
  done
  echo "错误: 找不到 commands.json（先运行 ./install.sh --host <host> --yes，或确认系统已 switch）" >&2
  return 1
}

need_jq() {
  [ -n "$JQ" ] || { echo "错误: 需要 jq（或先运行 ./install.sh 部署带 @JQ@ 注入的版本）" >&2; exit 1; }
}

case "${1:---list}" in
  --json)
    cat "$(locate)"
    ;;
  list)
    need_jq
    "$JQ" -r '"host: " + .generated.host + "   agent: " + (if .generated.agent_enabled then "on" else "off" end),
           (.commands | group_by(.category)[]
             | "\n[" + .[0].category + "]",
               (.[] | "  " + .name + "  —  " + .summary))' "$(locate)"
    ;;
  --category)
    cat_name="${2:?用法: agent-commands --category <runtime|workflow|check|agent|system>}"
    need_jq
    out=$("$JQ" -r --arg c "$cat_name" '.commands[] | select(.category == $c) | [.name, .summary] | @tsv' "$(locate)")
    [ -n "$out" ] || { echo "错误: 没有 category=$cat_name 的命令" >&2; exit 1; }
    printf '%s\n' "$out"
    ;;
  show)
    name="${2:?用法: agent-commands show <name>}"
    need_jq
    out=$("$JQ" --arg n "$name" '.commands[] | select(.name == $n)' "$(locate)")
    [ -n "$out" ] || { echo "错误: 清单里没有命令 $name（agent-commands list 查看全部）" >&2; exit 1; }
    printf '%s\n' "$out"
    ;;
  workflows)
    need_jq
    "$JQ" '.workflows' "$(locate)"
    ;;
  paths)
    need_jq
    file="$(locate)"
    # artifacts 里的 <XDG_*_DIR> 是构建期占位符；展开逻辑与截图/录屏共用能力层
    DE_LIB="${XDG_DATA_HOME:-@HOME@/.local/share}/hyprbuddy-os/lib/de.sh"
    [ -r "$DE_LIB" ] || DE_LIB="$(dirname "$(readlink -f "$0")")/lib/de.sh"
    if [ -r "$DE_LIB" ]; then . "$DE_LIB"; fi
    if command -v de_xdg_dir >/dev/null 2>&1; then
      pic="$(de_xdg_dir PICTURES Pictures)"
      vid="$(de_xdg_dir VIDEOS Videos)"
    else
      pic="$HOME/Pictures"
      vid="$HOME/Videos"
    fi
    expanded="$("$JQ" --arg pic "$pic" --arg vid "$vid" '
      .paths
      | .artifacts.screenshots |= gsub("<XDG_PICTURES_DIR>"; $pic)
      | .artifacts.recordings  |= gsub("<XDG_VIDEOS_DIR>"; $vid)
    ' "$file")"
    if [ "${2:-}" = "--json" ]; then
      printf '%s\n' "$expanded"
    else
      printf '%s' "$expanded" | "$JQ" -r '
        "repo:               " + .repo,
        "skills:             " + (.skills | join(", ")),
        "user_config:",
        (.user_config[] | "  " + .),
        "artifacts:",
        (.artifacts | to_entries[] | "  " + .key + ": " + .value)
      '
    fi
    ;;
  -h|--help|help)
    sed -n '2,9p' "$0" | sed 's/^# *//'
    ;;
  *)
    echo "用法: agent-commands [--json | list | show <name> | --category <cat> | workflows | paths]" >&2
    exit 1
    ;;
esac
