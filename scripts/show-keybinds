#!/usr/bin/env bash
# @command: show-keybinds
# @summary: 显示当前 Hyprland 快捷键（浮动 kitty）
# @category: runtime
# @usage: show-keybinds
# @effect: 打开浮动 kitty 窗口
# 显示当前 Hyprland 所有快捷键（从 hyprctl binds 动态生成，带中文说明），
# 在浮动 kitty 弹窗中查看。
set -uo pipefail

out="${XDG_RUNTIME_DIR:-/tmp}/hypr-keybinds.txt"

python3 - "$out" <<'PY'
import sys, json, subprocess, re

try:
    binds = json.loads(subprocess.check_output(["hyprctl", "-j", "binds"]))
except Exception as e:
    open(sys.argv[1], "w").write(f"无法获取快捷键: {e}\n")
    sys.exit(0)

# 组合键 → 中文说明
DESC = {
    "SUPER+RETURN": "打开终端 (kitty)",
    "SUPER+D": "应用启动器 (fuzzel)",
    "SUPER+SPACE": "打开主菜单",
    "SUPER+B": "浏览器 (firefox)",
    "SUPER+E": "文件管理器 (thunar)",
    "SUPER+L": "锁屏",
    "SUPER+M": "注销并退出桌面",
    "SUPER+Q": "关闭当前窗口",
    "SUPER+F": "全屏切换",
    "SUPER+T": "窗口浮动/平铺切换",
    "SUPER+P": "伪平铺 (pseudo)",
    "SUPER+J": "切换分屏方向",
    "SUPER+V": "剪贴板历史",
    "SUPER+S": "切换临时工作区 (scratchpad)",
    "SHIFT+SUPER+S": "把窗口移入临时工作区",
    "SHIFT+SUPER+R": "重载 Hyprland 配置",
    "SHIFT+SUPER+A": "区域截图并标注",
    "SHIFT+SUPER+C": "屏幕取色（复制色值）",
    "SHIFT+SUPER+N": "夜间模式开关 (4000K)",
    "SHIFT+SUPER+P": "开始/停止录屏",
    "SHIFT+SUPER+W": "下一张壁纸",
    "PRINT": "区域截图",
    "SHIFT+PRINT": "整屏截图",
    "SUPER+left": "聚焦左侧窗口",
    "SUPER+right": "聚焦右侧窗口",
    "SUPER+up": "聚焦上方窗口",
    "SUPER+down": "聚焦下方窗口",
    "SHIFT+SUPER+left": "把窗口向左移动",
    "SHIFT+SUPER+right": "把窗口向右移动",
    "SHIFT+SUPER+up": "把窗口向上移动",
    "SHIFT+SUPER+down": "把窗口向下移动",
    "ALT+SUPER+left": "减小窗口宽度",
    "ALT+SUPER+right": "增大窗口宽度",
    "ALT+SUPER+up": "减小窗口高度",
    "ALT+SUPER+down": "增大窗口高度",
    "SUPER+mouse:272": "Super + 左键拖动：移动窗口",
    "SUPER+mouse:273": "Super + 右键拖动：调整窗口大小",
    "XF86AudioRaiseVolume": "音量增大（SwayOSD 屏显）",
    "XF86AudioLowerVolume": "音量减小（SwayOSD 屏显）",
    "XF86AudioMute": "静音切换",
    "XF86MonBrightnessUp": "亮度增大（SwayOSD 屏显）",
    "XF86MonBrightnessDown": "亮度减小（SwayOSD 屏显）",
    "XF86AudioPlay": "播放/暂停",
    "XF86AudioNext": "下一曲",
    "XF86AudioPrev": "上一曲",
}

FALLBACK = {
    "movefocus": "移动焦点",
    "movewindow": "移动窗口",
    "resizeactive": "调整窗口大小",
    "workspace": "切换工作区",
    "movetoworkspace": "把窗口移到工作区",
    "togglespecialworkspace": "切换临时工作区",
    "exec": "执行命令",
}

def describe(combo, rhs):
    if combo in DESC:
        return DESC[combo]
    m = re.fullmatch(r"SUPER\+(\d)", combo)
    if m:
        n = int(m.group(1)) or 10
        return f"切换到工作区 {n}"
    m = re.fullmatch(r"SHIFT\+SUPER\+(\d)", combo)
    if m:
        n = int(m.group(1)) or 10
        return f"把窗口移到工作区 {n}"
    disp = rhs.split()[0] if rhs else ""
    return FALLBACK.get(disp, rhs)

modnames = [(1, "SHIFT"), (2, "CAPS"), (4, "CTRL"), (8, "ALT"),
            (16, "MOD2"), (32, "MOD3"), (64, "SUPER"), (128, "MOD5")]
rows = []
for b in binds:
    m = int(b.get("modmask", 0) or 0)
    mods = [n for bit, n in modnames if m & bit]
    key = b.get("key") or ""
    if not key and b.get("keycode"):
        key = f"code:{b['keycode']}"
    disp = b.get("dispatcher", "")
    arg = (b.get("arg") or "").strip()
    rhs = arg if disp == "exec" else f"{disp} {arg}".strip()
    combo = "+".join(mods + ([key] if key else []))
    rows.append((combo, rhs))

rows.sort(key=lambda r: (r[0].lower(), r[1]))
with open(sys.argv[1], "w") as f:
    f.write("Hyprland 快捷键参考（当前系统）\n")
    f.write("=" * 64 + "\n\n")
    f.write(f"{'组合键':<26} → 功能说明\n")
    f.write("-" * 64 + "\n")
    for combo, rhs in rows:
        f.write(f"{combo:<26} → {describe(combo, rhs)}\n")
    f.write("\n共 %d 条\n" % len(rows))
PY

if [ "${KB_NO_POPUP:-0}" = "1" ]; then
  cat "$out"
  exit 0
fi

kitty --class keybinds-popup --title "快捷键参考" -e sh -c '
  if command -v less >/dev/null 2>&1; then
    less -R "$1"
  else
    cat "$1"; printf "\n按 Enter 关闭..."; read -r _
  fi
' _ "$out"
