#!/usr/bin/env bash
# theme-next: 在若干内置主题间循环切换桌面配色
#   theme-next          切换到下一套（默认动作）
#   theme-next restore  应用已保存的主题（登录时由 exec-once 调用，不前进索引）
#
# 覆盖范围：Hyprland 边框/窗口色（hyprctl 实时）+ 壁纸 + Waybar（CSS 变量覆盖）
#           + Kitty（include 持久化 + 实时 set-colors）+ hyprlock 锁屏。
set -uo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
STATE_DIR="$RUNTIME/theme-next"
STATE="$STATE_DIR/idx"
WALL="$HOME/Pictures/wallpapers"

mkdir -p "$STATE_DIR"

# 主题表字段：
# name|wallpaper|ha1|ha2|hi
# |wb_bg|wb_fg|wb_ws|wb_wsafg|wb_wsabg|wb_urgent|wb_clock|wb_cpu|wb_mem|wb_bat|wb_pulse|wb_agent
# |k_bg|k_fg|k_cursor|k0..k15(16)
THEMES=(
"Kanagawa|01-kanagawa.png|7E9CD8|957FB8|54546D|16161D|DCD7BA|54546D|DCD7BA|2A2A37|FF5D62|7AA89F|76946A|DCA561|957FB8|7E9CD8|957FB8|1F1F28|DCD7BA|DCD7BA|1F1F28|C34043|76946A|C0A36E|7E9CD8|957FB8|6A9589|C5C9C5|717C7C|C34043|76946A|C0A36E|7E9CD8|957FB8|6A9589|DCD7BA"
"Tokyo Night|02-tokyo-night.png|7AA2F7|BB9AF7|565F89|16161E|C0CAF5|565F89|7AA2F7|1F2335|F7768E|7DCFFF|9ECE6A|E0AF68|BB9AF7|2AC3DE|BB9AF7|1A1B26|C0CAF5|C0CAF5|15161E|F7768E|9ECE6A|E0AF68|7AA2F7|BB9AF7|7DCFFF|A9B1D6|414868|F7768E|9ECE6A|E0AF68|7AA2F7|BB9AF7|7DCFFF|C0CAF5"
"Catppuccin Mocha|03-catppuccin-mocha.png|89B4FA|CBA6F7|6C7086|1E1E2E|CDD6F4|6C7086|CDD6F4|313244|F38BA8|89DCEB|A6E3A1|F9E2AF|CBA6F7|94E2D5|CBA6F7|1E1E2E|CDD6F4|F5E0DC|45475A|F38BA8|A6E3A1|F9E2AF|89B4FA|CBA6F7|94E2D5|BAC2DE|585B70|F38BA8|A6E3A1|F9E2AF|89B4FA|CBA6F7|94E2D5|CDD6F4"
"Rose Pine|04-rose-pine.png|9CCFD8|C4A7E7|6E6A86|191724|E0DEF4|6E6A86|E0DEF4|2A283E|EB6F92|9CCFD8|31748F|F6C177|C4A7E7|EBBCBA|C4A7E7|191724|E0DEF4|E0DEF4|191724|EB6F92|31748F|F6C177|9CCFD8|C4A7E7|EBBCBA|908CA4|6E6A86|EB6F92|31748F|F6C177|9CCFD8|C4A7E7|EBBCBA|E0DEF4"
"Nord|05-nord.png|81A1C1|B48EAD|4C566A|2E3440|D8DEE9|4C566A|D8DEE9|3B4252|BF616A|88C0D0|A3BE8C|EBCB8B|B48EAD|8FBCBB|B48EAD|2E3440|D8DEE9|D8DEE9|2E3440|BF616A|A3BE8C|EBCB8B|81A1C1|B48EAD|8FBCBB|E5E9F0|4C566A|BF616A|A3BE8C|EBCB8B|81A1C1|B48EAD|8FBCBB|ECEFF4"
)

N=${#THEMES[@]}

get_idx() {
  local i=0
  [ -f "$STATE" ] && i=$(cat "$STATE" 2>/dev/null || echo 0)
  case "$i" in (*[!0-9]*) i=0 ;; esac
  [ "$i" -ge "$N" ] && i=0
  echo "$i"
}

cur_idx=$(get_idx)
if [ "${1:-next}" = "restore" ]; then
  idx=$cur_idx
else
  idx=$(( (cur_idx + 1) % N ))
  echo "$idx" > "$STATE"
fi

IFS='|' read -r NAME WALLPAPER HA1 HA2 HI \
  WB_BG WB_FG WB_WS WB_WSAFG WB_WSABG WB_URGENT WB_CLOCK WB_CPU WB_MEM WB_BAT WB_PULSE WB_AGENT \
  K_BG K_FG K_CURSOR \
  K0 K1 K2 K3 K4 K5 K6 K7 K8 K9 K10 K11 K12 K13 K14 K15 <<< "${THEMES[$idx]}"

# ── Hyprland 边框（实时，无需重建） ──────────────
if command -v hyprctl >/dev/null 2>&1; then
  [ "${1:-next}" = "restore" ] && sleep 1
  hyprctl keyword general:col.active_border "rgba(${HA1}ee) rgba(${HA2}ee) 45deg" 2>/dev/null
  hyprctl keyword general:col.inactive_border "rgba(${HI}aa)" 2>/dev/null
fi

# ── 壁纸（hyprpaper 已在 exec-once 启动，直接下发） ──
IMG="$WALL/$WALLPAPER"
if [ -f "$IMG" ] && command -v hyprctl >/dev/null 2>&1; then
  hyprctl hyprpaper preload "$IMG" 2>/dev/null
  hyprctl hyprpaper wallpaper ",$IMG" 2>/dev/null
fi

# ── Waybar（整份重写 style.css + 重启） ─────────
# GTK CSS 不支持 :root / var()，必须写具体颜色值。
# style.css 默认是指向 store 的软链，先摘掉再写常规文件。
mkdir -p "$XDG_CONFIG_HOME/waybar"
rm -f "$XDG_CONFIG_HOME/waybar/style.css"
rm -f "$XDG_CONFIG_HOME/waybar/theme.css"
cat > "$XDG_CONFIG_HOME/waybar/style.css" <<CSS
* {
  font-family: "Noto Sans CJK SC", sans-serif;
  font-size: 13px;
  color: #${WB_FG};
  border: none;
  border-radius: 0;
}
window#waybar { background: transparent; }
window#waybar > box {
  background: #${WB_BG};
  border-radius: 12px;
  padding: 2px 8px;
  margin: 0 4px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.4);
}
#workspaces button { padding: 0 6px; color: #${WB_WS}; border-radius: 8px; }
#workspaces button.active { color: #${WB_WSAFG}; background: #${WB_WSABG}; }
#workspaces button.urgent { color: #${WB_URGENT}; }
#clock { color: #${WB_CLOCK}; }
#cpu { color: #${WB_CPU}; }
#memory { color: #${WB_MEM}; }
#battery { color: #${WB_BAT}; }
#pulseaudio { color: #${WB_PULSE}; }
#custom-agent-usage { color: #${WB_AGENT}; padding: 0 6px; }
CSS
# 在跑就重启（换肤生效），没跑就拉起（登录后 CSS 被旧缓存打断等场景）。
# 注意匹配方式：NixOS 包装的 waybar 进程 comm 是 ".waybar-wrapped"，
# pgrep -x waybar 永远匹配不上（旧实例杀不掉会堆叠），须用对 comm 子串匹配的
# 无标志 pgrep/pkill waybar。
# flock 串行化：exec-once 的 restore 与配置自动 reload 触发的 restore 可能并发，
# 不加锁会 pkill/setsid 交错导致状态栏堆叠出多份。
(
  flock -x 200
  if pgrep waybar >/dev/null 2>&1; then
    pkill waybar 2>/dev/null
    sleep 0.4
  fi
  setsid waybar >/dev/null 2>&1 < /dev/null 200>&- &   # 200>&- 防止子进程继承锁 fd
) 200>"$RUNTIME/theme-next/waybar.lock"

# ── fuzzel 启动器（替换 [colors] 段，其余保持仓库配置） ──
# fuzzel 即用即读配置，无需重启。fuzzel.ini 默认是 store 软链，摘链后写常规文件。
FUZZEL="$XDG_CONFIG_HOME/fuzzel/fuzzel.ini"
if [ -f "$FUZZEL" ]; then
  if [ -L "$FUZZEL" ]; then FSRC=$(readlink -f "$FUZZEL"); else FSRC="$FUZZEL"; fi
  mkdir -p "$XDG_CONFIG_HOME/fuzzel"
  # 先写临时文件，非空才替换（store 中间链接未就绪等异常时不留 0 字节配置）
  awk -v bg="${WB_BG}ff" -v fg="${WB_FG}ff" -v mtc="${WB_WSAFG}ff" \
      -v sel="${WB_WSABG}ff" -v seltxt="${WB_FG}ff" -v selmtc="${WB_PULSE}ff" \
      -v border="${WB_WSAFG}ff" '
    /^\[colors\]/ { inblk=1
      print "[colors]"
      print "background=" bg
      print "text=" fg
      print "match=" mtc
      print "selection=" sel
      print "selection-text=" seltxt
      print "selection-match=" selmtc
      print "border=" border
      next }
    /^\[/ { inblk=0 }
    !inblk { print }
  ' "$FSRC" > "$FUZZEL.tmp" 2>/dev/null || true
  if [ -s "$FUZZEL.tmp" ]; then
    mv -f "$FUZZEL.tmp" "$FUZZEL"
  else
    rm -f "$FUZZEL.tmp"
  fi
fi

# ── mako 通知（替换颜色键 + makoctl reload 热加载） ──
MAKO="$XDG_CONFIG_HOME/mako/config"
if [ -f "$MAKO" ]; then
  if [ -L "$MAKO" ]; then MSRC=$(readlink -f "$MAKO"); else MSRC="$MAKO"; fi
  mkdir -p "$XDG_CONFIG_HOME/mako"
  awk -v bg="${WB_BG}f2" -v fg="${WB_FG}" -v border="${WB_WSAFG}" \
      -v prog="${WB_PULSE}cc" -v low="${WB_WS}" -v crit="${WB_URGENT}" '
    /^\[/ { sec=$0 }
    sec == "" {
      if ($0 ~ /^background-color=/) { print "background-color=#" bg; next }
      if ($0 ~ /^text-color=/)       { print "text-color=#" fg; next }
      if ($0 ~ /^border-color=/)     { print "border-color=#" border; next }
      if ($0 ~ /^progress-color=/)   { print "progress-color=#" prog; next }
    }
    sec == "[urgency=low]" && $0 ~ /^border-color=/ { print "border-color=#" low; next }
    sec == "[urgency=critical]" && $0 ~ /^border-color=/ { print "border-color=#" crit; next }
    { print }
  ' "$MSRC" > "$MAKO.tmp" 2>/dev/null || true
  if [ -s "$MAKO.tmp" ]; then
    mv -f "$MAKO.tmp" "$MAKO"
    makoctl reload >/dev/null 2>&1 || true
  else
    rm -f "$MAKO.tmp"
  fi
fi

# ── swayosd OSD（值替换 + 重启 swayosd-server） ──
# 注意 comm 是 .swayosd-server（包装器改名），与 waybar 同理用无标志 pgrep/pkill
OSD="$XDG_CONFIG_HOME/swayosd/style.css"
if [ -f "$OSD" ]; then
  if [ -L "$OSD" ]; then SSRC=$(readlink -f "$OSD"); else SSRC="$OSD"; fi
  mkdir -p "$XDG_CONFIG_HOME/swayosd"
  sed -e "s/#0f2438/#${WB_BG}/" \
      -e "s/#0e7fa8/#${WB_WSAFG}/" \
      -e "s/#d7e7f5/#${WB_FG}/" \
      -e "s/#1e9bd8/#${WB_PULSE}/" \
      -e "s/#1b3d5f/#${WB_WSABG}/" \
      "$SSRC" > "$OSD.tmp" 2>/dev/null || true
  (
    flock -x 201
    if [ -s "$OSD.tmp" ]; then
      mv -f "$OSD.tmp" "$OSD"
    else
      rm -f "$OSD.tmp"
    fi
    if pgrep swayosd-server >/dev/null 2>&1; then
      pkill swayosd-server 2>/dev/null
      sleep 0.3
      setsid swayosd-server >/dev/null 2>&1 < /dev/null 201>&- &
    fi
  ) 201>"$RUNTIME/theme-next/osd.lock"
fi

# ── Kitty（include 持久化 + 实时 set-colors） ───
mkdir -p "$XDG_CONFIG_HOME/kitty"
cat > "$XDG_CONFIG_HOME/kitty/theme.inc.conf" <<KITTY
foreground #${K_FG}
background #${K_BG}
cursor #${K_CURSOR}
cursor_text_color #${K_BG}
selection_background #${K_FG}
selection_foreground #${K_BG}
color0  #${K0}
color1  #${K1}
color2  #${K2}
color3  #${K3}
color4  #${K4}
color5  #${K5}
color6  #${K6}
color7  #${K7}
color8  #${K8}
color9  #${K9}
color10 #${K10}
color11 #${K11}
color12 #${K12}
color13 #${K13}
color14 #${K14}
color15 #${K15}
KITTY
if command -v kitty >/dev/null 2>&1; then
  kitty @ set-colors -a \
    background=#${K_BG} foreground=#${K_FG} cursor=#${K_CURSOR} \
    color0=#${K0} color1=#${K1} color2=#${K2} color3=#${K3} color4=#${K4} color5=#${K5} color6=#${K6} color7=#${K7} \
    color8=#${K8} color9=#${K9} color10=#${K10} color11=#${K11} color12=#${K12} color13=#${K13} color14=#${K14} color15=#${K15} \
    2>/dev/null || true
fi

# ── hyprlock 锁屏（只写变量；控件块在 hyprlock.conf 里，写控件块会因 source 追加出重复控件） ──
mkdir -p "$XDG_CONFIG_HOME/hypr"
cat > "$XDG_CONFIG_HOME/hypr/theme-hyprlock.conf" <<LOCK
\$hl_bg = rgba(${WB_BG}ff)
\$hl_fg = rgba(${WB_FG}ff)
\$hl_inner = rgba(${WB_BG}e6)
\$hl_outer = rgba(${WB_AGENT}ff)
\$hl_dots = rgba(${WB_FG}ff)
\$hl_bgpath = ${HOME}/Pictures/wallpapers/${WALLPAPER}
LOCK

command -v notify-send >/dev/null 2>&1 && notify-send -a theme-next "主题 -> $NAME" 2>/dev/null || true

echo "theme: $NAME ($((idx+1))/$N)"
