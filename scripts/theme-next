#!/usr/bin/env bash
# @command: theme-next
# @summary: 在内置主题间循环切换（P2 编排器：tokens.json + exporters）
# @category: runtime
# @usage: theme-next [restore | <idx>]
# @arg restore: 应用已保存主题（登录时调用，不前进索引）
# @arg <idx>: 直接应用第 idx 套主题（theme-picker 使用）
# @effect: 按 exporters/hyprland/* 重写各应用配置并重启对应服务
# @doc: theming.md
# theme-next: 主题切换编排器
#   theme-next          切换到下一套
#   theme-next restore  应用已保存主题（登录 exec-once 调用）
#   theme-next <idx>    直接指定（主题预览选择器使用）
#   theme-next --print-themes  输出主题清单（选择器数据源）
#
# P2 重构：主题定义在 themes/<slug>/tokens.json（唯一真相），写入逻辑在
# exporters/hyprland/*.sh；本脚本只做索引管理 + tokens 环境展开 + 编排。
# niri 栈的主题应用走 de_theme_apply → exporters/niri/。
set -uo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
mkdir -p "$RUNTIME/theme-next" 2>/dev/null || true
# 索引持久化：XDG_STATE_HOME（XDG_RUNTIME_DIR 是 tmpfs，重启即失）
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/theme-next"
STATE="$STATE_DIR/idx"
mkdir -p "$STATE_DIR"

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# 仓库内：scripts/../exporters；部署后：share/hyprland-nixos/exporters
LIB_DIR="$(dirname "$(dirname "$SELF")")/exporters"
[ -d "$LIB_DIR" ] || LIB_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/hyprland-nixos/exporters"
. "$LIB_DIR/lib.sh"

mapfile -t SLUGS < <(theme_list)
N=${#SLUGS[@]}
[ "$N" -gt 0 ] || { echo "theme-next: $THEMES_DIR 下没有主题" >&2; exit 1; }

get_idx() {
  local i=0
  [ -f "$STATE" ] && i=$(cat "$STATE" 2>/dev/null || echo 0)
  case "$i" in (*[!0-9]*) i=0 ;; esac
  [ "$i" -ge "$N" ] && i=0
  echo "$i"
}

cur_idx=$(get_idx)

# 主题清单（theme-picker 数据源）：idx<TAB>名称<TAB>壁纸<TAB>色板(5色)<TAB>当前标记
if [ "${1:-}" = "--print-themes" ]; then
  for i in "${!SLUGS[@]}"; do
    theme_env_load "${SLUGS[$i]}" || continue
    tag=""
    [ "$i" = "$cur_idx" ] && tag="← 当前"
    printf '%s\t%s\t%s/%s\t%s\t%s\n' \
      "$i" "$T_NAME" "$HOME/Pictures/wallpapers" "$T_WALLPAPER" \
      "$T_BG,$T_FG,$T_ACCENT,$T_ACCENT2,$T_URGENT" "$tag"
  done
  exit 0
fi

req="${1:-next}"
if [ "$req" = "restore" ]; then
  idx=$cur_idx
elif [[ "$req" =~ ^[0-9]+$ ]] && [ "$req" -lt "$N" ]; then
  idx=$req
  echo "$idx" > "$STATE"
else
  idx=$(( (cur_idx + 1) % N ))
  echo "$idx" > "$STATE"
fi

slug=${SLUGS[$idx]}
theme_env_load "$slug" || exit 1
# restore 时 hyprctl reload 前先等会话就绪（沿用 v0 行为）
[ "$req" = "restore" ] && sleep 1

# ── 编排 ──────────────────────────────────────────────────────────────

# agent 主题跟随（agent 层未启用时脚本不存在，静默跳过）；
# 明暗按背景亮度判断，与 v0 一致
AGENT_MODE=dark
if [ $(( (16#${T_BG:0:2} * 299 + 16#${T_BG:2:2} * 587 + 16#${T_BG:4:2} * 114) / 1000 )) -ge 140 ]; then
  AGENT_MODE=light
fi
[ -x "@HOME@/.local/bin/agent-theme-sync" ] && "@HOME@/.local/bin/agent-theme-sync" "$AGENT_MODE" >/dev/null 2>&1 || true

# restore 不弹通知，避免登录时同一主题重复弹窗
command -v notify-send >/dev/null 2>&1 && [ "$req" != "restore" ] && timeout 3 notify-send -a theme-next "主题 -> $T_NAME" 2>/dev/null || true

echo "theme: $T_NAME ($((idx+1))/$N)"
