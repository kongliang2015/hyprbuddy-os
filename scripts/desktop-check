#!/usr/bin/env bash
# @command: desktop-check
# @summary: 桌面自检（niri + Noctalia）
# @category: check
# @usage: desktop-check [niri]
# @effect: 只读检查，返回 1 表示有告警（含键位命令存在性、壁纸目录、夜间模式、配置告警）
# @doc: desktop-abstraction.md
# COSMIC 于 2026-10-28 退役，Hyprland 于 v1-nn 退役；当前只有 niri 提供方。
set -uo pipefail
self=$(dirname "$(readlink -f "$0")")
DE_LIB="${XDG_DATA_HOME:-@HOME@/.local/share}/hyprland-nixos/lib/de.sh"
[ -r "$DE_LIB" ] || DE_LIB="$self/lib/de.sh"
. "$DE_LIB"

warn=0
info() { printf '  - %s\n' "$1"; }
bad()  { printf '  ! %s\n' "$1"; warn=$((warn+1)); }

de="${1:-$(de_name)}"
case "$de" in
  niri)
    info "桌面: niri + Noctalia v5"

    # 1) 核心进程
    if pgrep -x niri >/dev/null 2>&1; then
      info "进程 niri 在运行"
    else
      bad "进程 niri 未运行"
    fi
    # noctalia 走 wrapProgram，comm 是 .noctalia-wrapped（pgrep -x 匹配不到），
    # 用 IPC 是否可用作为存活判据。install.sh 在非图形 shell 里跑自检时没有
    # WAYLAND_DISPLAY，此时跳过运行态检查，避免假告警。
    runtime=1
    [ -n "${WAYLAND_DISPLAY:-}" ] || runtime=0
    if [ "$runtime" = 0 ]; then
      info "非图形会话（无 WAYLAND_DISPLAY），跳过 noctalia 运行态检查"
    elif command -v noctalia >/dev/null 2>&1 && noctalia msg status >/dev/null 2>&1; then
      info "进程 noctalia 在运行（IPC 可用）"
    else
      bad "进程 noctalia 未运行（IPC 无响应）"
    fi
    if pgrep -f xwayland-satellite >/dev/null 2>&1; then
      info "Xwayland (xwayland-satellite) 在运行"
    else
      info "xwayland-satellite 未运行（无 X11 应用时正常）"
    fi

    # 2) portal（niri 走 gnome 门户：录屏/文件选择）
    if busctl --user list 2>/dev/null | grep -q 'impl.portal.desktop.gnome'; then
      info "gnome portal 已注册（impl.portal.desktop.gnome）"
    else
      bad "gnome portal 未注册（截图/录屏会失败）"
    fi

    # 3) 壁纸：Noctalia 内置服务（awww 已于 v1-nn P3 移除，不再检查外部守护）
    if [ "$runtime" = 0 ]; then
      : # 非图形会话跳过
    elif command -v noctalia >/dev/null 2>&1; then
      wp=$(noctalia msg wallpaper-get 2>/dev/null | head -n1)
      if [ -n "$wp" ]; then
        info "壁纸由 Noctalia 提供（$(printf "%s" "$wp" | sed "s|$HOME|~|")）"
      else
        bad "Noctalia 未报告壁纸（屏幕可能没有壁纸）"
      fi
    else
      bad "noctalia 不可用（壁纸与面板都会缺失）"
    fi

    # 4) 外壳状态：v5 用 IPC status 判定 bar 是否创建（图层名与 v4 不同，不再按名字匹配）
    if [ "$runtime" = 0 ]; then
      : # 非图形会话跳过
    elif command -v noctalia >/dev/null 2>&1; then
      status=$(noctalia msg status 2>/dev/null)
      if printf '%s' "$status" | grep -q '"locked": true'; then
        # 锁屏时 v5 会主动隐藏 bar，此时 barVisible=false 是正常行为
        info "会话已锁定（Noctalia 锁屏中，bar 隐藏属正常）"
      elif printf '%s' "$status" | grep -q '"barVisible": true'; then
        info "Noctalia 状态栏运行中"
      else
        bad "Noctalia bar 未显示（被 bar-toggle/bar-hide 隐藏？用 noctalia msg bar-show 恢复）"
      fi
    fi
    # 5) 中文字体解析
    cjk=$(fc-match ":lang=zh-cn" -f "%{family}" 2>/dev/null)
    case "$cjk" in
      *"文泉驿"*) info "中文解析: $cjk" ;;
      *) bad "中文解析为 $cjk（期望文泉驿）" ;;
    esac

    # 6) 常用命令
    for c in niri noctalia grim slurp swappy wf-recorder; do
      command -v "$c" >/dev/null 2>&1 && info "命令 $c 可用" || bad "命令 $c 缺失"
    done

    # 7) 键位引用的命令是否存在（防止「绑了但命令没装」这类静默失效）
    cfg="$HOME/.config/niri/config.kdl"
    if [ -r "$cfg" ]; then
      missing=""
      for c in $(grep -o 'spawn "[^"]*"' "$cfg" | cut -d'"' -f2 | sort -u); do
        command -v "$c" >/dev/null 2>&1 || missing="$missing $c"
      done
      if [ -z "$missing" ]; then
        info "键位引用的命令都存在"
      else
        bad "键位引用了不存在的命令:$missing"
      fi
    else
      bad "缺少 niri config.kdl"
    fi

    # 8) 主题、壁纸目录与夜间模式（Noctalia v5 的生成配置）
    td="$HOME/.config/noctalia/theme.toml"
    if [ -f "$td" ]; then
      info "Noctalia 配色基线存在（theme.toml，壁纸取色）"
      wdir=$(sed -n 's/^directory *= *"\(.*\)"/\1/p' "$td" | head -n1)
      if [ -n "$wdir" ]; then
        if [ -d "$wdir" ]; then
          info "壁纸目录可用（$wdir）"
        else
          bad "壁纸目录不存在：$wdir（wallpaper-next 会失败）"
        fi
      else
        info "未配置壁纸目录（wallpaper-next 不可用；wallpaper-set 不受影响）"
      fi
    else
      bad "缺少 ~/.config/noctalia/theme.toml（切一次主题或跑 theme-next restore）"
    fi

    nlc="$HOME/.config/noctalia/nightlight.toml"
    if [ -f "$nlc" ]; then
      if grep -q 'enabled *= *true' "$nlc" 2>/dev/null; then
        # 日志里最后一次 gamma 判定若是 no schedule，说明 location 没解析出坐标
        glog=$(tail -n 400 "$HOME/.cache/noctalia/noctalia.log" 2>/dev/null | grep -a 'gamma' | tail -n1)
        case "$glog" in
          *"no schedule"*) bad "夜间模式已启用但日程未解析（gamma no schedule：检查 location）" ;;
          *gamma*) info "夜间模式已启用，色温日程已由 location 解析" ;;
          *) info "夜间模式已启用（尚无 gamma 日志，登录后生效）" ;;
        esac
      else
        info "夜间模式已配置但未启用（nightlight.toml enabled=false）"
      fi
    else
      info "未启用夜间模式（无 nightlight.toml）"
    fi

    # 9) 配置告警（unknown setting 会让配置项静默失效）
    nlog="$HOME/.cache/noctalia/noctalia.log"
    if [ -r "$nlog" ] && tail -n 300 "$nlog" | grep -aq 'unknown setting'; then
      bad "Noctalia 配置有 unknown setting（看 noctalia.log 最近的 [config] 告警）"
    else
      info "Noctalia 配置无 unknown setting"
    fi
    ;;
  *)
    bad "未识别的桌面: $de（当前仅支持 niri）"
    ;;
esac

if [ "$warn" -gt 0 ]; then
  printf "  自检完成：%s 项告警\n" "$warn"
  exit 1
fi
printf "  自检通过\n"
