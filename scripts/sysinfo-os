#!/usr/bin/env bash
# @command: sysinfo-os
# @summary: 系统信息里的 OS 行（发行版名 + NixOS 版本 + 仓库分支/提交）
# @category: runtime
# @usage: sysinfo-os
# @effect: 打印一行文本，供 fastfetch 的 command 模块使用
set -uo pipefail

repo="${HYPRBUDDY_REPO:-$HOME/hyprbuddy-os}"
ver=$(nixos-version 2>/dev/null | cut -d' ' -f1 | cut -d. -f1,2)
branch=$(git -C $repo rev-parse --abbrev-ref HEAD 2>/dev/null)
rev=$(git -C $repo rev-parse --short HEAD 2>/dev/null)
printf "HyprBuddy %s · %s@%s" "${ver:-26.05}" "${branch:--}" "${rev:--}"
