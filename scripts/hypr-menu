#!/usr/bin/env bash
# @command: hypr-menu
# @summary: Super+Space 系统菜单（应用/截图/外观/会话/快捷键）
# @category: runtime
# @usage: hypr-menu
# @effect: 打开 fuzzel 菜单并执行所选动作
# @interactive: true
# Hyprland 超级菜单（Super+Space）
# 通用多层菜单：每一层（非根）自动注入「← 返回上级菜单」，Esc 返回上一级；
# 根菜单注入「✕ 退出菜单」。
# 图标用 Nerd Font 字形（本机图标主题是精简版，无 apps 图标可用）。
set -uo pipefail

fmenu() {
  fuzzel --dmenu --lines 10 --minimal-lines --width 34 \
         --namespace hypr-menu --anchor center \
         --placeholder '输入筛选…' --prompt "${1:-  }" \
         --mesg 'Enter 执行 · Esc 返回/退出'
}

# ── 菜单项辅助：输出 "标签<TAB>类型<TAB>值" ──────────────
act() { printf '%s\tact\t%s\n' "$1" "$2"; }
sub() { printf '%s\tsub\t%s\n' "$1" "$2"; }

# ── 状态探测（菜单项实时显示开关）────────────────────────
night_state() { [ -f "${XDG_RUNTIME_DIR:-/tmp}/hyprsunset.on" ] && printf '✓ 开' || printf '关'; }
dnd_state()   { [ "$(swaync-client -D 2>/dev/null)" = "true" ] && printf '✓ 开' || printf '关'; }

# ── 菜单树 ──────────────────────────────────────────────
menu_entries() {
  case "$1" in
    root)
      sub '  应用'            apps
      act '  区域截图'        'hyprshot -m region'
      sub '  系统工具'         tools
      sub '  外观'           appearance
      sub '  会话'             session
      act '  通知中心'        'swaync-client -t'
      act '  日历'            '@HOME@/.local/bin/eww-popup calendar'
      act '  系统信息'        '@HOME@/.local/bin/show-sysinfo'
      act '  快捷键参考'      '@HOME@/.local/bin/show-keybinds'
      ;;
    apps)
      act '  应用启动器'    'fuzzel'
      act '  终端 (kitty)'    'kitty'
      act '  文件管理器'    'thunar'
      act '  浏览器'         'firefox'
      act '  系统监视器'     'kitty -e btop'
      ;;
    tools)
      sub '  截图'          screenshot
      act '  取色器'          'hyprpicker -a'
      act '  剪贴板历史'      'cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'
      act '  开始/停止录屏'  '@HOME@/.local/bin/record-toggle'
      ;;
    screenshot)
      act '  区域截图'        'hyprshot -m region'
      act '  整屏截图'        'hyprshot -m output'
      act '  截图标注'      '@HOME@/.local/bin/screenshot-annotate'
      ;;
    appearance)
      act "  夜间模式        [$(night_state)]" '@HOME@/.local/bin/night-mode'
      act '  下一张壁纸'       '@HOME@/.local/bin/wallpaper-next'
      act '  切换主题'       '@HOME@/.local/bin/theme-next'
      act '  主题预览'       'kitty --class theme-picker --title 主题预览 -e @HOME@/.local/bin/theme-picker'
      sub '  登录界面主题'     sddm
      sub '  登录界面主题'     sddm
      act '  重新加载壁纸'  '__reload_wallpaper__'
      act '  重载 Hyprland' 'hyprctl reload'
      ;;
    sddm)
      # 条目由 sddm-theme list 动态生成：id<TAB>显示名<TAB>路径<TAB>当前标记
      local s_id s_name s_path s_mark
      while IFS=$'\t' read -r s_id s_name s_path s_mark; do
        [ -n "$s_id" ] || continue
        if [ -n "$s_mark" ]; then
          act "  $s_name"       "@HOME@/.local/bin/sddm-theme set $s_id"
        else
          act "  $s_name"       "@HOME@/.local/bin/sddm-theme set $s_id"
        fi
      done < <(@HOME@/.local/bin/sddm-theme list 2>/dev/null)
      act '  恢复默认（删除 override）' '@HOME@/.local/bin/sddm-theme reset'
      ;;

    sddm)
      # 条目由 sddm-theme list 动态生成：id<TAB>显示名<TAB>路径<TAB>当前标记
      local s_id s_name s_path s_mark
      while IFS=$'\t' read -r s_id s_name s_path s_mark; do
        [ -n "$s_id" ] || continue
        if [ -n "$s_mark" ]; then
          act "✓ $s_name"       "@HOME@/.local/bin/sddm-theme set $s_id"
        else
          act "   $s_name"      "@HOME@/.local/bin/sddm-theme set $s_id"
        fi
      done < <(@HOME@/.local/bin/sddm-theme list 2>/dev/null)
      act '   恢复默认（删除 override）' '@HOME@/.local/bin/sddm-theme reset'
      ;;
    session)
      act '  锁屏'            'hyprlock'
      act "  通知勿扰        [$(dnd_state)]" '@HOME@/.local/bin/notif-dnd'
      act '  注销'             'hyprctl dispatch exit'
      act '  重启'         '__reboot__'
      act '  关机'           '__poweroff__'
      ;;
  esac
}

menu_prompt() {
  case "$1" in
    root)       echo '主菜单 > ' ;;
    apps)       echo '应用 > ' ;;
    tools)      echo '系统工具 > ' ;;
    screenshot) echo '截图 > ' ;;
    appearance) echo '外观 > ' ;;
    sddm)       echo '登录主题 > ' ;;
    session)    echo '会话 > ' ;;
    *)          echo '> ' ;;
  esac
}

run_action() {
  case "$1" in
    __reload_wallpaper__)
      # awww/swww 链路：重设当前主题壁纸（含守护兜底）
      "@HOME@/.local/bin/theme-next" restore >/dev/null 2>&1 &
      ;;
    __reboot__)
      [ "$(printf 'No\nYes' | fmenu 'Restart? ')" = Yes ] && systemctl reboot
      ;;
    __poweroff__)
      [ "$(printf 'No\nYes' | fmenu 'Poweroff? ')" = Yes ] && systemctl poweroff
      ;;
    *)
      setsid sh -c "$1" >/dev/null 2>&1 < /dev/null &
      ;;
  esac
}

# ── 递归菜单 ────────────────────────────────────────────
run_menu() {
  local id="$1" parent="${2:-}"
  while true; do
    local -a entries=() labels=()
    mapfile -t entries < <(menu_entries "$id")

    local e
    for e in "${entries[@]}"; do
      labels+=("${e%%$'\t'*}")
    done
    if [ -n "$parent" ]; then
      labels+=('  返回上级菜单')
    else
      labels+=('  退出菜单')
    fi

    local choice
    choice=$(printf '%s\n' "${labels[@]}" | fmenu "$(menu_prompt "$id")") || return 0

    if [ "$choice" = '  返回上级菜单' ] || [ "$choice" = '  退出菜单' ]; then
      return 0
    fi

    local label kind val found=0
    for e in "${entries[@]}"; do
      label="${e%%$'\t'*}"
      if [ "$label" = "$choice" ]; then
        found=1
        kind="${e#*$'\t'}"
        kind="${kind%%$'\t'*}"
        val="${e##*$'\t'}"
        if [ "$kind" = 'sub' ]; then
          run_menu "$val" "$id"
          break
        else
          run_action "$val"
          exit 0
        fi
      fi
    done
    [ "$found" = 1 ] || return 0
  done
}

run_menu root
