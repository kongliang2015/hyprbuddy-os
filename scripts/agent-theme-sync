#!/usr/bin/env bash
# 让 agent 的明暗主题跟随系统：只改 theme 字段，保留其余设置。
set -euo pipefail

f="${HOME}/.claude/settings.json"
mkdir -p "${HOME}/.claude"

if command -v jq >/dev/null 2>&1 && [ -s "$f" ]; then
  tmp=$(mktemp)
  jq '. + {theme: "dark"}' "$f" > "$tmp" && mv "$tmp" "$f"
else
  printf '{\n  "theme": "dark"\n}\n' > "$f"
fi

echo "claude theme -> dark"
