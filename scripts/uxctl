#!/usr/bin/env python3
# @command: uxctl
# @summary: COSMIC UX 配置的受控读写（U1：dump / diff）
# @category: runtime
# @usage: uxctl dump [--ns NS|all] [--json] [--raw] | uxctl diff <profile.json> [--json]
# @effect: dump 只读；diff 只读，比较 profile 与当前值
# @doc: cosmic-ux-agent.md
"""uxctl —— COSMIC UX 配置入口（U1：dump / diff）。

设计见 docs/cosmic-ux-agent.md：agent 不得直接编辑 ~/.config/cosmic/**，
一切读写经本工具（白名单 + 类型校验 + 原子写 + 快照）。
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys

NS = {
    "panel": "com.system76.CosmicPanel.Panel",
    "dock": "com.system76.CosmicPanel.Dock",
    "comp": "com.system76.CosmicComp",
    "applist": "com.system76.CosmicAppList",
    "background": "com.system76.CosmicBackground",
    "notifications": "com.system76.CosmicNotifications",
    "idle": "com.system76.CosmicIdle",
    "shortcuts": "com.system76.CosmicSettings.Shortcuts",
    "panels": "com.system76.CosmicPanel",
}

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")

# ── schema：只允许这些键（白名单）────────────────────────────────────────
# 每项：(类型, 额外约束)
SCHEMA = {
    ("panel", "anchor"):            ("enum", ["Top", "Bottom", "Left", "Right"]),
    ("panel", "layer"):             ("enum", ["Background", "Bottom", "Top", "Overlay"]),
    ("panel", "size"):              ("enum", ["XS", "S", "M", "L", "XL"]),
    ("panel", "size_center"):       ("enum", ["XS", "S", "M", "L", "XL", "None"]),
    ("panel", "size_wings"):        ("enum", ["XS", "S", "M", "L", "XL", "None"]),
    ("panel", "background"):        ("enum", ["ThemeDefault", "Dark", "Light", "Custom"]),
    ("panel", "keyboard_interactivity"): ("enum", ["OnDemand", "Exclusive", "None"]),
    ("panel", "output"):            ("enum", ["All"]),
    ("panel", "autohide"):          ("autohide", None),
    ("panel", "border_radius"):     ("number", (0, 32)),
    ("panel", "opacity"):           ("number", (0.3, 1.0)),
    ("panel", "margin"):            ("int", (0, 64)),
    ("panel", "spacing"):           ("int", (0, 64)),
    ("panel", "padding"):           ("int", (0, 64)),
    ("panel", "exclusive_zone"):    ("bool", None),
    ("panel", "expand_to_edges"):   ("bool", None),
    ("panel", "plugins_center"):    ("applist", None),
    ("panel", "plugins_wings"):     ("wings", None),
    ("dock", "anchor"):             ("enum", ["Top", "Bottom", "Left", "Right"]),
    ("dock", "layer"):              ("enum", ["Background", "Bottom", "Top", "Overlay"]),
    ("dock", "size"):               ("enum", ["XS", "S", "M", "L", "XL"]),
    ("dock", "autohide"):           ("autohide", None),
    ("dock", "border_radius"):      ("number", (0, 32)),
    ("dock", "opacity"):            ("number", (0.3, 1.0)),
    ("dock", "margin"):             ("int", (0, 64)),
    ("dock", "spacing"):            ("int", (0, 64)),
    ("dock", "padding"):            ("int", (0, 64)),
    ("dock", "exclusive_zone"):     ("bool", None),
    ("dock", "expand_to_edges"):    ("bool", None),
    ("dock", "plugins_center"):     ("applist", None),
    ("dock", "plugins_wings"):      ("wings", None),
    ("comp", "autotile"):           ("bool", None),
    ("comp", "autotile_behavior"):  ("enum", ["Global", "PerWorkspace"]),
}


def ns_dir(ns: str) -> str:
    return os.path.join(CONFIG_HOME, "cosmic", NS[ns], "v1")


def classify(text: str) -> str:
    t = text.strip()
    if t in ("true", "false"):
        return "bool"
    if re.fullmatch(r"-?\d+\.\d+", t):
        return "float"
    if re.fullmatch(r"-?\d+", t):
        return "int"
    if t == "None":
        return "none"
    if t.startswith("Some("):
        return "some"
    if t.startswith("["):
        return "list"
    if t.startswith("("):
        return "record"
    if t.startswith('"'):
        return "string"
    return "enum"


def read_key(ns: str, key: str) -> str | None:
    p = os.path.join(ns_dir(ns), key)
    if not os.path.isfile(p):
        return None
    with open(p, "r", encoding="utf-8") as fh:
        return fh.read().strip()


def known_applets() -> set[str]:
    apps = "/run/current-system/sw/share/applications"
    ids = set()
    try:
        for name in os.listdir(apps):
            if name.startswith("com.system76.Cosmic") and name.endswith(".desktop"):
                ids.add(name[: -len(".desktop")])
    except OSError:
        pass
    # 面板内建 widget（不是独立 .desktop）：官方布局模板里会出现
    ids |= {
        "com.system76.CosmicPanelWorkspacesButton",
        "com.system76.CosmicPanelAppButton",
        "com.system76.CosmicPanelLauncherButton",
        "com.system76.CosmicAppList",
        "com.system76.CosmicAppLibrary",
    }
    return ids


APPLETS = known_applets()


# ── RON 渲染（模板化，不拼裸字符串）────────────────────────────────────────
def r_applist(items: list[str]) -> str:
    if not items:
        return "None"
    body = "\n".join(f'    "{i}",' for i in items)
    return f"Some([\n{body}\n])"


def r_wings(w: dict) -> str:
    left = w.get("left") or []
    right = w.get("right") or []
    if not left and not right:
        return "None"
    def block(items):
        return "[\n" + "\n".join(f'    "{i}",' for i in items) + "\n]" if items else "[]"
    return f"Some(({block(left)}, {block(right)}))"


def r_autohide(a) -> str:
    if a is None:
        return "None"
    fields = [
        ("wait_time", 500), ("transition_time", 200), ("handle_size", 2),
        ("unhide_delay_ms", 0),
    ]
    body = "\n".join(f"    {k}: {a.get(k, d)}," for k, d in fields)
    return f"Some((\n{body}\n))"


def render(ns: str, key: str, value) -> tuple[str | None, str | None]:
    """返回 (ron_text, error)。"""
    spec = SCHEMA.get((ns, key))
    if spec is None:
        return None, f"未知键（不在 schema 白名单）: {ns}.{key}"
    kind, rule = spec

    if kind == "enum":
        if not isinstance(value, str) or value not in rule:
            return None, f"{ns}.{key} 必须是 {rule} 之一，收到 {value!r}"
        return value, None

    if kind in ("number",):
        if not isinstance(value, (int, float)) or isinstance(value, bool):
            return None, f"{ns}.{key} 需要数字，收到 {value!r}"
        lo, hi = rule
        if not (lo <= value <= hi):
            return None, f"{ns}.{key} 超出范围 {lo}–{hi}，收到 {value}"
        return (str(value) if isinstance(value, int) else f"{value:g}"), None

    if kind == "int":
        if not isinstance(value, int) or isinstance(value, bool):
            return None, f"{ns}.{key} 需要整数，收到 {value!r}"
        lo, hi = rule
        if not (lo <= value <= hi):
            return None, f"{ns}.{key} 超出范围 {lo}–{hi}"
        return str(value), None

    if kind == "bool":
        if not isinstance(value, bool):
            return None, f"{ns}.{key} 需要 true/false，收到 {value!r}"
        return ("true" if value else "false"), None

    if kind == "applist":
        if value is None:
            return "None", None
        if not isinstance(value, list) or not all(isinstance(i, str) for i in value):
            return None, f"{ns}.{key} 需要字符串数组或 null"
        unknown = [i for i in value if APPLETS and i not in APPLETS]
        if unknown:
            return None, f"{ns}.{key} 含未知 applet: {', '.join(unknown)}"
        return r_applist(value), None

    if kind == "wings":
        if value is None:
            return "None", None
        if not isinstance(value, dict):
            return None, f"{ns}.{key} 需要 {{left:[], right:[]}} 或 null"
        items = (value.get("left") or []) + (value.get("right") or [])
        unknown = [i for i in items if APPLETS and i not in APPLETS]
        if unknown:
            return None, f"{ns}.{key} 含未知 applet: {', '.join(unknown)}"
        return r_wings(value), None

    if kind == "autohide":
        if value is None:
            return "None", None
        if not isinstance(value, dict):
            return None, f"{ns}.{key} 需要对象或 null"
        allowed = {"wait_time", "transition_time", "handle_size", "unhide_delay_ms"}
        extra = set(value) - allowed
        if extra:
            return None, f"{ns}.{key} 含未知字段: {', '.join(sorted(extra))}"
        return r_autohide(value), None

    return None, f"内部错误：未处理的类型 {kind}"


def norm(text: str) -> str:
    return re.sub(r"\s+", "", text or "")


# ── 命令实现 ─────────────────────────────────────────────────────────────
def dump_ns(ns: str) -> dict:
    d = ns_dir(ns)
    out = {"namespace": NS[ns], "path": d, "exists": os.path.isdir(d), "keys": {}}
    if not os.path.isdir(d):
        return out
    for name in sorted(os.listdir(d)):
        p = os.path.join(d, name)
        if not os.path.isfile(p):
            continue
        try:
            raw = read_key(ns, name) or ""
        except OSError as exc:
            out["keys"][name] = {"error": str(exc)}
            continue
        out["keys"][name] = {"type": classify(raw), "raw": raw}
    out["count"] = len(out["keys"])
    return out


def cmd_dump(args) -> int:
    names = list(NS) if args.ns == "all" else [args.ns]
    data = {ns: dump_ns(ns) for ns in names}
    if args.json:
        print(json.dumps(data, ensure_ascii=False, indent=2))
        return 0
    for ns, info in data.items():
        state = "" if info["exists"] else "  (目录不存在)"
        print(f"[{ns}] {info['namespace']}{state}")
        if not info["keys"]:
            print("  (无配置键)")
            continue
        width = max(len(k) for k in info["keys"])
        for k, v in info["keys"].items():
            if "error" in v:
                print(f"  {k:<{width}}  error  {v['error']}")
                continue
            raw = v["raw"] if args.raw else " ".join(v["raw"].split())
            if not args.raw and len(raw) > 70:
                raw = raw[:67] + "..."
            print(f"  {k:<{width}}  {v['type']:<6} {raw}")
        print(f"  — {info['count']} 个键")
    return 0


def cmd_diff(args) -> int:
    try:
        with open(args.profile, "r", encoding="utf-8") as fh:
            profile = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"uxctl diff: 读取 profile 失败: {exc}", file=sys.stderr)
        return 2

    changes, errors = collect(profile)
    changed_names = {(c["ns"], c["key"]) for c in changes}
    same = []
    for ns, keys in profile.items():
        if ns == "version" or not isinstance(keys, dict) or ns not in NS:
            continue
        for key, want in keys.items():
            if (ns, key) in changed_names or any(e["ns"] == ns and e["key"] == key for e in errors):
                continue
            ron, err = render(ns, key, want)
            if err is None:
                same.append({"ns": ns, "key": key, "current": read_key(ns, key), "desired": ron})

    if args.json:
        print(json.dumps({"changes": changes, "same": same, "errors": errors},
                         ensure_ascii=False, indent=2))
        return 1 if errors else 0

    def show(label, items):
        if not items:
            return
        print(f"{label}：")
        w = max(len(f"{i['ns']}.{i['key']}") for i in items)
        for i in items:
            name = f"{i['ns']}.{i['key']}"
            cur = " ".join((i["current"] or "(不存在)").split())
            if len(cur) > 48:
                cur = cur[:45] + "..."
            des = " ".join(i["desired"].split())
            if len(des) > 48:
                des = des[:45] + "..."
            print(f"  {name:<{w}}  {cur}  →  {des}")

    print(f"profile: {args.profile}")
    show("将变更", changes)
    show("无变化", same)
    if errors:
        print("错误：")
        for e in errors:
            name = f"{e['ns']}.{e['key']}" if e["key"] else e["ns"]
            print(f"  {name}: {e['error']}")
    total = len(changes)
    print(f"\n合计：{total} 处变更，{len(same)} 处一致，{len(errors)} 处错误")
    return 1 if errors else 0


STATE_DIR = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "uxctl")
SNAP_DIR = os.path.join(STATE_DIR, "snapshots")
MAX_CHANGES = 12


def now_id() -> str:
    import datetime
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")


def collect(profile: dict) -> tuple[list[dict], list[dict]]:
    """返回 (changes, errors)。"""
    changes, errors = [], []
    for ns, keys in profile.items():
        if ns == "version":
            continue
        if ns not in NS:
            errors.append({"ns": ns, "key": "", "error": f"未知命名空间: {ns}"})
            continue
        if not isinstance(keys, dict):
            errors.append({"ns": ns, "key": "", "error": "该命名空间的值必须是对象"})
            continue
        for key, want in keys.items():
            ron, err = render(ns, key, want)
            if err:
                errors.append({"ns": ns, "key": key, "error": err})
                continue
            cur = read_key(ns, key)
            item = {"ns": ns, "key": key, "current": cur, "desired": ron}
            if cur is not None and norm(cur) == norm(ron):
                continue
            changes.append(item)
    return changes, errors


def write_atomic(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text if text.endswith("\n") else text + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    os.replace(tmp, path)


def make_snapshot(changes: list[dict], reason: str) -> str:
    sid = now_id()
    root = os.path.join(SNAP_DIR, sid)
    n = 1
    while os.path.exists(root):          # 同一秒多次 apply
        n += 1
        root = os.path.join(SNAP_DIR, f"{sid}-{n}")
    os.makedirs(root, exist_ok=True)

    files = []
    for c in changes:
        src = os.path.join(ns_dir(c["ns"]), c["key"])
        existed = os.path.isfile(src)
        entry = {"ns": c["ns"], "key": c["key"], "existed": existed}
        if existed:
            rel = os.path.join(c["ns"], c["key"])
            dst = os.path.join(root, "files", rel)
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            with open(src, "r", encoding="utf-8") as fh:
                write_atomic(dst, fh.read())
        files.append(entry)

    manifest = {
        "id": os.path.basename(root),
        "created": sid,
        "reason": reason,
        "files": files,
    }
    with open(os.path.join(root, "manifest.json"), "w", encoding="utf-8") as fh:
        json.dump(manifest, fh, ensure_ascii=False, indent=2)
    return os.path.basename(root)


def restore_snapshot(sid: str) -> int:
    root = os.path.join(SNAP_DIR, sid)
    man_path = os.path.join(root, "manifest.json")
    if not os.path.isfile(man_path):
        print(f"uxctl: 找不到快照 {sid}", file=sys.stderr)
        return 1
    with open(man_path, "r", encoding="utf-8") as fh:
        man = json.load(fh)

    restored = 0
    for f in man["files"]:
        dst = os.path.join(ns_dir(f["ns"]), f["key"])
        if f["existed"]:
            src = os.path.join(root, "files", f["ns"], f["key"])
            with open(src, "r", encoding="utf-8") as fh:
                write_atomic(dst, fh.read())
        else:
            if os.path.isfile(dst):
                os.remove(dst)
        restored += 1
    print(f"已还原 {restored} 个键（快照 {sid}，{man.get('created','')}）")
    return 0


def cmd_snapshot(args) -> int:
    if args.action == "list":
        if not os.path.isdir(SNAP_DIR):
            print("（暂无快照）")
            return 0
        ids = sorted(os.listdir(SNAP_DIR), reverse=True)
        if not ids:
            print("（暂无快照）")
            return 0
        for sid in ids:
            mp = os.path.join(SNAP_DIR, sid, "manifest.json")
            if not os.path.isfile(mp):
                continue
            with open(mp, "r", encoding="utf-8") as fh:
                man = json.load(fh)
            keys = ", ".join(f"{f['ns']}.{f['key']}" for f in man["files"][:4])
            more = "" if len(man["files"]) <= 4 else f" 等 {len(man['files'])} 项"
            print(f"{sid}  {len(man['files'])} 键  {keys}{more}")
            if man.get("reason"):
                print(f"    reason: {man['reason']}")
        return 0

    if args.action == "restore":
        if not args.id:
            print("uxctl snapshot restore <id>", file=sys.stderr)
            return 2
        return restore_snapshot(args.id)

    print("uxctl snapshot [list|restore <id>]", file=sys.stderr)
    return 2


def cmd_apply(args) -> int:
    try:
        with open(args.profile, "r", encoding="utf-8") as fh:
            profile = json.load(fh)
    except (OSError, json.JSONDecodeError) as exc:
        print(f"uxctl apply: 读取 profile 失败: {exc}", file=sys.stderr)
        return 2

    changes, errors = collect(profile)
    if errors:
        print("拒绝应用，存在校验错误：", file=sys.stderr)
        for e in errors:
            name = f"{e['ns']}.{e['key']}" if e["key"] else e["ns"]
            print(f"  {name}: {e['error']}", file=sys.stderr)
        return 1

    if not changes:
        print("无变更（profile 与当前配置一致）")
        return 0

    if len(changes) > MAX_CHANGES:
        print(f"拒绝应用：本次 {len(changes)} 处变更超过上限 {MAX_CHANGES}", file=sys.stderr)
        return 1

    w = max(len(f"{c['ns']}.{c['key']}") for c in changes)
    for c in changes:
        name = f"{c['ns']}.{c['key']}"
        cur = " ".join((c["current"] or "(不存在)").split())[:40]
        des = " ".join(c["desired"].split())[:40]
        print(f"  {name:<{w}}  {cur}  →  {des}")

    if not args.yes:
        print(f"\n共 {len(changes)} 处变更，未写入（加 --yes 应用）")
        return 0

    reason = args.reason or os.path.basename(args.profile)
    sid = make_snapshot(changes, reason)
    print(f"\n快照: {sid}")

    for c in changes:
        write_atomic(os.path.join(ns_dir(c["ns"]), c["key"]), c["desired"])

    # 写后校验：读回比对，不一致立即回滚
    bad = []
    for c in changes:
        back = read_key(c["ns"], c["key"])
        if back is None or norm(back) != norm(c["desired"]):
            bad.append(c)
    if bad:
        print("校验失败，正在回滚：", file=sys.stderr)
        for c in bad:
            print(f"  {c['ns']}.{c['key']}", file=sys.stderr)
        restore_snapshot(sid)
        return 1

    print(f"已应用 {len(changes)} 处变更，校验通过")
    print(f"回滚: uxctl snapshot restore {sid}")
    return 0


LAYOUT_DIR = "/run/current-system/sw/share/cosmic-layouts"


def read_layout(path: str) -> dict:
    """读取一个系统布局模板：layout.kdl 元数据 + cosmic-config 树。"""
    info = {"id": os.path.basename(path), "name": "", "keys": {}}
    kdl = os.path.join(path, "layout.kdl")
    if os.path.isfile(kdl):
        with open(kdl, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line.startswith("name en="):
                    info["name"] = line.split("=", 1)[1].strip().strip('"')
                    break
    for ns in sorted(os.listdir(path)):
        v1 = os.path.join(path, ns, "v1")
        if not os.path.isdir(v1):
            continue
        keys = {}
        for k in sorted(os.listdir(v1)):
            p = os.path.join(v1, k)
            if os.path.isfile(p):
                with open(p, "r", encoding="utf-8") as fh:
                    keys[k] = fh.read().strip()
        if keys:
            info["keys"][ns] = keys
    return info


def cmd_layout(args) -> int:
    if not os.path.isdir(LAYOUT_DIR):
        print(f"uxctl: 未找到系统布局模板目录 {LAYOUT_DIR}", file=sys.stderr)
        return 1
    items = [read_layout(os.path.join(LAYOUT_DIR, d))
             for d in sorted(os.listdir(LAYOUT_DIR))
             if os.path.isdir(os.path.join(LAYOUT_DIR, d))]
    if args.json:
        print(json.dumps(items, ensure_ascii=False, indent=2))
        return 0
    for it in items:
        n = sum(len(v) for v in it["keys"].values())
        print(f"{it['id']:<28} {it['name']}")
        for ns, keys in it["keys"].items():
            short = ns.replace("com.system76.", "")
            print(f"    {short}: {len(keys)} 键")
        if n == 0:
            print("    （空模板）")
    print(f"\n来源: {LAYOUT_DIR}（cosmic-initial-setup 自带）")
    return 0


def main(argv: list[str]) -> int:
    ap = argparse.ArgumentParser(prog="uxctl")
    sub = ap.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("dump", help="打印当前配置")
    d.add_argument("--ns", default="all", choices=list(NS) + ["all"])
    d.add_argument("--json", action="store_true")
    d.add_argument("--raw", action="store_true", help="不截断原始文本")
    d.set_defaults(func=cmd_dump)

    f = sub.add_parser("diff", help="对比 profile 与当前配置（只读）")
    f.add_argument("profile", help="profile JSON 路径")
    f.add_argument("--json", action="store_true")
    f.set_defaults(func=cmd_diff)

    a = sub.add_parser("apply", help="应用 profile（默认 dry-run，需 --yes 写入）")
    a.add_argument("profile", help="profile JSON 路径")
    a.add_argument("--yes", action="store_true", help="真正写入（否则只打印变更）")
    a.add_argument("--reason", default="", help="写入快照的备注")
    a.set_defaults(func=cmd_apply)

    s = sub.add_parser("snapshot", help="快照管理")
    s.add_argument("action", choices=["list", "restore"])
    s.add_argument("id", nargs="?")
    s.set_defaults(func=cmd_snapshot)

    l = sub.add_parser("layout", help="系统布局模板（只读列举）")
    l.add_argument("action", nargs="?", default="list", choices=["list"])
    l.add_argument("--json", action="store_true")
    l.set_defaults(func=cmd_layout)

    args = ap.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
