#!/usr/bin/env bash
# @command: hypr-check
# @summary: Hyprland 配置自检：Lua 优先 / configerrors / 0.55 规则语法
# @category: check
# @usage: hypr-check
# @effect: 只读
# @doc: troubleshooting.md
# Hyprland 配置自检（由 install.sh 调用，也可手动执行）。
#   1. 0.55 的 Lua 优先规则：存在 hyprland.lua 时 .conf 会被忽略
#   2. 运行时解析错误：hyprctl configerrors（需在 Hyprland 会话内）
#   3. 规则语法 lint：0.55 要求 match: 前缀，旧语法可能静默失效
# 退出码：0 = 通过，1 = 有警告。
set -uo pipefail

conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"
lua="${conf%.conf}.lua"
status=0
warn() { echo "  ! $*"; status=1; }
info() { echo "  - $*"; }

# 1) Lua 优先
if [ -f "$lua" ]; then
  warn "存在 $lua：Hyprland 0.55 会优先加载 Lua 配置，$conf 将被忽略"
fi

# 2) 运行时解析错误（会话外 hyprctl version 会失败，自动跳过）
if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
  errs=$(hyprctl configerrors 2>/dev/null | sed '/^[[:space:]]*$/d')
  if [ -n "$errs" ]; then
    warn "hyprctl configerrors 报告解析错误："
    printf '%s\n' "$errs" | sed 's/^/      /'
  else
    info "configerrors 无错误"
  fi
else
  info "未在 Hyprland 会话中，跳过运行时检查"
fi

# 3) 规则语法 lint
if [ -f "$conf" ]; then
  old_wr=$(grep -nE '^[[:space:]]*windowrule[[:space:]]*=[[:space:]]*[a-z_]+[[:space:]]+(class|title|initial_class|initial_title):' "$conf" 2>/dev/null)
  old_lr=$(grep -nE '^[[:space:]]*layerrule[[:space:]]*=[[:space:]]*[a-z_]+[[:space:]]*,' "$conf" 2>/dev/null)
  if [ -n "$old_wr" ]; then
    warn "windowrule 疑似 0.54 旧语法（0.55 下静默失效，不报错）："
    printf '%s\n' "$old_wr" | sed 's/^/      /'
    echo "      正确：windowrule = match:class ^(名字)$, float true, size monitor_w*0.72 monitor_h*0.72"
  fi
  if [ -n "$old_lr" ]; then
    warn "layerrule 疑似 0.54 旧语法（0.55 下报 invalid field）："
    printf '%s\n' "$old_lr" | sed 's/^/      /'
    echo "      正确：layerrule = match:namespace <namespace>, blur true, ignore_alpha 0.3"
  fi
  [ -z "$old_wr$old_lr" ] && info "windowrule/layerrule 语法符合 0.55"
fi

# 4) 命令清单一致性（manifest vs 已部署脚本）
JQ="@JQ@"
[ -x "$JQ" ] || JQ="$(command -v jq || true)"
manifest=""
for f in "$HOME/.local/share/hyprland-nixos/commands.json" "/etc/xdg/hyprland-nixos/commands.json"; do
  [ -f "$f" ] && { manifest="$f"; break; }
done
if [ -z "$manifest" ]; then
  info "未找到 commands.json，跳过清单一致性检查（先运行 ./install.sh）"
elif [ -z "$JQ" ]; then
  info "无 jq，跳过清单一致性检查"
else
  listed=$("$JQ" -r '.commands | length' "$manifest" 2>/dev/null || echo 0)
  total=$("$JQ" -r '.generated.scripts_total // 0' "$manifest" 2>/dev/null || echo 0)
  src=$("$JQ" -r '.generated.scripts_source // "?"' "$manifest" 2>/dev/null || echo '?')
  if [ "$total" -gt 0 ] && [ "$listed" != "$total" ]; then
    warn "commands.json 条目数($listed) 与生成时脚本数($total) 不一致（可能被手工修改）"
  fi
  missing=""
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    [ -x "$HOME/.local/bin/$n" ] || missing="$missing $n"
  done < <("$JQ" -r '.commands[] | select(.available) | .name' "$manifest" 2>/dev/null)
  if [ -n "$missing" ]; then
    warn "清单标记可用但未部署：$missing"
    echo "      修复：./install.sh --host <host> --yes"
  else
    info "清单与已部署命令一致（$listed 个，指纹 ${src}）"
  fi
fi

# 5) SDDM 运行时主题 override（写错会让登录界面起不来）
ovr=/etc/sddm.conf.d/50-sddm-theme.conf
if [ -f "$ovr" ]; then
  ovr_cur=$(sed -n 's/^[[:space:]]*Current[[:space:]]*=[[:space:]]*//p' "$ovr" 2>/dev/null | tail -1)
  case "$ovr_cur" in
    "")
      warn "SDDM override 存在但缺少 Current 键：$ovr"
      ;;
    /*)
      if [ -f "$ovr_cur/Main.qml" ]; then
        info "SDDM 登录主题 override 有效：$(basename "$ovr_cur")"
      else
        warn "SDDM override 指向无效主题：$ovr_cur（登录界面可能黑屏，执行 sddm-theme reset）"
      fi
      ;;
    *)
      info "SDDM 登录主题 override：$ovr_cur（ThemeDir 内）"
      ;;
  esac
fi

# 6) hyprtoolkit 配色（hyprpolkitagent 0.2.0 的认证框读它）
htk="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprtoolkit.conf"
if [ -f "$htk" ]; then
  if [ ! -s "$htk" ]; then
    warn "hyprtoolkit.conf 是空文件：$htk（认证框会退回默认灰）"
  else
    miss=""
    for k in background base text accent; do
      grep -qE "^[[:space:]]*$k[[:space:]]*=" "$htk" || miss="$miss $k"
    done
    if [ -n "$miss" ]; then
      warn "hyprtoolkit.conf 缺少键：$miss（认证框配色会不完整）"
    else
      info "hyprtoolkit 配色就绪（认证框跟随主题）"
    fi
  fi
fi

if [ "$status" -eq 0 ]; then
  echo "  - 自检通过"
fi
exit "$status"
