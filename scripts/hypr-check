#!/usr/bin/env bash
# @command: hypr-check
# @summary: Hyprland 配置自检：Lua 优先 / configerrors / 0.55 规则语法
# @category: check
# @usage: hypr-check
# @effect: 只读
# @doc: troubleshooting.md
# Hyprland 配置自检（由 install.sh 调用，也可手动执行）。
#   1. 0.55 的 Lua 优先规则：存在 hyprland.lua 时 .conf 会被忽略
#   2. 运行时解析错误：hyprctl configerrors（需在 Hyprland 会话内）
#   3. 规则语法 lint：0.55 要求 match: 前缀，旧语法可能静默失效
# 退出码：0 = 通过，1 = 有警告。
set -uo pipefail

conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf"
lua="${conf%.conf}.lua"
status=0
warn() { echo "  ! $*"; status=1; }
info() { echo "  - $*"; }

# 1) Lua 配置管理器（hyprshell 的 eval 键位依赖它）
if [ -f "$lua" ]; then
  info "使用 Lua 配置管理器（$lua），hyprland.conf 被忽略"
elif [ -f "$conf" ]; then
  info "使用经典 hyprland.conf（hyprshell 的热键自注册需要 Lua 配置管理器）"
fi

# 2) 运行时解析错误（会话外 hyprctl version 会失败，自动跳过）
if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
  errs=$(hyprctl configerrors 2>/dev/null | sed '/^[[:space:]]*$/d')
  if [ -n "$errs" ]; then
    warn "hyprctl configerrors 报告解析错误："
    printf '%s\n' "$errs" | sed 's/^/      /'
  else
    info "configerrors 无错误"
  fi
else
  info "未在 Hyprland 会话中，跳过运行时检查"
fi

# 3) 规则语法 lint（只检查真正生效的那份配置）
# Lua 配置管理器下 hyprland.conf 完全不加载，再去 lint 它只会给出假阳性。
if [ -f "$lua" ]; then
  binds=$(grep -cE '^[[:space:]]*hl\.bind\(' "$lua" 2>/dev/null || true)
  wrules=$(grep -cE '^[[:space:]]*hl\.window_rule\(' "$lua" 2>/dev/null || true)
  lrules=$(grep -cE '^[[:space:]]*hl\.layer_rule\(' "$lua" 2>/dev/null || true)
  : "${binds:=0}"; : "${wrules:=0}"; : "${lrules:=0}"
  if [ "$binds" -lt 10 ]; then
    warn "$lua 只有 $binds 条 hl.bind(...)，看起来不完整（期望 40+）"
  else
    info "hyprland.lua：$binds 条键位 / $wrules 条窗口规则 / $lrules 条图层规则"
  fi
  # 迁移时真实踩过的两个 Lua 写法坑
  if grep -qE 'hl\.curve\(\{' "$lua" 2>/dev/null; then
    warn "hl.curve 是位置参数：hl.curve(\"name\", { type = \"bezier\", points = {...} })"
  fi
  if grep -q 'tap-to-click' "$lua" 2>/dev/null; then
    warn "Lua 配置里 touchpad 要用 tap_to_click（连字符会报 unknown config key）"
  fi
  [ -f "$conf" ] && info "hyprland.conf 会被忽略（Lua 生效）；改配置请改 hyprland.lua"
else
  if [ -f "$conf" ]; then
    old_wr=$(grep -nE '^[[:space:]]*windowrule[[:space:]]*=[[:space:]]*[a-z_]+[[:space:]]+(class|title|initial_class|initial_title):' "$conf" 2>/dev/null)
    old_lr=$(grep -nE '^[[:space:]]*layerrule[[:space:]]*=[[:space:]]*[a-z_]+[[:space:]]*,' "$conf" 2>/dev/null)
    if [ -n "$old_wr" ]; then
      warn "windowrule 疑似 0.54 旧语法（0.55 下静默失效，不报错）："
      printf '%s\n' "$old_wr" | sed 's/^/      /'
    fi
    if [ -n "$old_lr" ]; then
      warn "layerrule 疑似 0.54 旧语法（0.55 下报 invalid field）："
      printf '%s\n' "$old_lr" | sed 's/^/      /'
    fi
    [ -z "$old_wr$old_lr" ] && info "windowrule/layerrule 语法符合 0.55"
  fi
fi

# 4) 命令清单一致性（manifest vs 已部署脚本）
JQ="@JQ@"
[ -x "$JQ" ] || JQ="$(command -v jq || true)"
manifest=""
for f in "$HOME/.local/share/hyprland-nixos/commands.json" "/etc/xdg/hyprland-nixos/commands.json"; do
  [ -f "$f" ] && { manifest="$f"; break; }
done
if [ -z "$manifest" ]; then
  info "未找到 commands.json，跳过清单一致性检查（先运行 ./install.sh）"
elif [ -z "$JQ" ]; then
  info "无 jq，跳过清单一致性检查"
else
  listed=$("$JQ" -r '.commands | length' "$manifest" 2>/dev/null || echo 0)
  total=$("$JQ" -r '.generated.scripts_total // 0' "$manifest" 2>/dev/null || echo 0)
  src=$("$JQ" -r '.generated.scripts_source // "?"' "$manifest" 2>/dev/null || echo '?')
  if [ "$total" -gt 0 ] && [ "$listed" != "$total" ]; then
    warn "commands.json 条目数($listed) 与生成时脚本数($total) 不一致（可能被手工修改）"
  fi
  missing=""
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    [ -x "$HOME/.local/bin/$n" ] || missing="$missing $n"
  done < <("$JQ" -r '.commands[] | select(.available) | .name' "$manifest" 2>/dev/null)
  if [ -n "$missing" ]; then
    warn "清单标记可用但未部署：$missing"
    echo "      修复：./install.sh --host <host> --yes"
  else
    info "清单与已部署命令一致（$listed 个，指纹 ${src}）"
  fi
fi

# 5) SDDM 运行时主题 override（写错会让登录界面起不来）
ovr=/etc/sddm.conf.d/50-sddm-theme.conf
if [ -f "$ovr" ]; then
  ovr_cur=$(sed -n 's/^[[:space:]]*Current[[:space:]]*=[[:space:]]*//p' "$ovr" 2>/dev/null | tail -1)
  case "$ovr_cur" in
    "")
      warn "SDDM override 存在但缺少 Current 键：$ovr"
      ;;
    /*)
      if [ -f "$ovr_cur/Main.qml" ]; then
        info "SDDM 登录主题 override 有效：$(basename "$ovr_cur")"
      else
        warn "SDDM override 指向无效主题：$ovr_cur（登录界面可能黑屏，执行 sddm-theme reset）"
      fi
      ;;
    *)
      info "SDDM 登录主题 override：$ovr_cur（ThemeDir 内）"
      ;;
  esac
fi

# 6) hyprtoolkit 配色（hyprpolkitagent 0.2.0 的认证框读它）
htk="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprtoolkit.conf"
if [ -f "$htk" ]; then
  if [ ! -s "$htk" ]; then
    warn "hyprtoolkit.conf 是空文件：$htk（认证框会退回默认灰）"
  else
    miss=""
    for k in background base text accent; do
      grep -qE "^[[:space:]]*$k[[:space:]]*=" "$htk" || miss="$miss $k"
    done
    if [ -n "$miss" ]; then
      warn "hyprtoolkit.conf 缺少键：$miss（认证框配色会不完整）"
    else
      info "hyprtoolkit 配色就绪（认证框跟随主题）"
    fi
  fi
fi

# 7) 外壳组件（swaync / eww）：配置可解析 + 已知回归项
cfgdir="${XDG_CONFIG_HOME:-$HOME/.config}"
sn_cfg="$cfgdir/swaync/config.json"
sn_css="$cfgdir/swaync/style.css"
if [ -f "$sn_cfg" ]; then
  if python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$sn_cfg" 2>/dev/null; then
    info "swaync 配置 JSON 合法"
  else
    warn "swaync/config.json 不是合法 JSON（通知守护会退回默认配置）"
  fi
fi
if [ -f "$sn_css" ]; then
  # 把不带 # 的十六进制塞进 rgba()/alpha() 会让 GTK 丢弃整份样式（今日踩过）
  bad=$(grep -nE '(rgba|alpha)\([0-9A-Fa-f]{6}[,)]' "$sn_css" 2>/dev/null | head -3)
  if [ -n "$bad" ]; then
    warn "swaync/style.css 颜色写法错误（缺 #，GTK 会丢弃整份样式）："
    printf '%s\n' "$bad" | sed 's/^/      /'
  else
    info "swaync 样式颜色写法正常"
  fi
fi
if [ -f "$cfgdir/eww/eww.yuck" ]; then
  if grep -qE '^[[:space:]]*\(defwindow' "$cfgdir/eww/eww.yuck"; then
    info "eww 窗口定义存在"
  else
    warn "eww.yuck 里没有 defwindow（弹窗不会出现）"
  fi
fi
if [ -f "$conf" ] && grep -qE '^[[:space:]]*exec-once[[:space:]]*=[[:space:]]*mako' "$conf"; then
  warn "hyprland.conf 仍在启动 mako：它与 swaync 抢通知服务，只能留一个"
fi
# 8) 状态栏外壳（waybar）：登录后必须真的有 layer surface
# 2026-10-28 踩过：theme-next 重构丢掉 exporter 编排 → waybar 从未被拉起，
# 而 hyprland.lua 只调 theme-next restore，于是「进程没有、图层没有」。
if command -v hyprctl >/dev/null 2>&1 && hyprctl version >/dev/null 2>&1; then
  # 只认图层：pgrep -f waybar 会把「命令行里带 waybar 字样的进程」也算进来（误判过）
  if hyprctl layers 2>/dev/null | grep -q "namespace: waybar"; then
    info "waybar 已创建图层（状态栏可见）"
  else
    warn "状态栏缺失：waybar 没有创建图层（未启动，或配置/样式加载失败）"
    echo "      排查：pgrep -af waybar；journalctl --user -b | grep -i waybar"
    echo "      修复：theme-next restore    # 它 source exporters/hyprland/waybar.sh 拉起 waybar"
  fi
fi
if [ "$status" -eq 0 ]; then
  echo "  - 自检通过"
fi
exit "$status"
