#!/usr/bin/env bash
# @command: eww-popup
# @summary: 在当前聚焦显示器上切换 eww 弹窗（日历/会话）
# @category: runtime
# @usage: eww-popup <calendar|session>
# @effect: 打开/关闭对应 eww 弹窗，跟随焦点显示器
# eww 的 :monitor 只能在定义时写死，多显示器下会固定弹在主屏；
# 改用 eww open --screen <连接器名> 在调用时指定，键位和菜单都走这里。
set -uo pipefail

win="${1:-calendar}"
# hyprctl monitors 文本输出里取 focused: yes 对应的 Monitor 名字
mon="$(hyprctl monitors 2>/dev/null | awk '/^Monitor /{name=$2} /focused: yes/{print name; exit}')"
mon="${mon:-0}"

exec eww open --toggle --screen "$mon" "$win"
