#!/usr/bin/env bash
# @command: screenshot-output
# @summary: 整屏截图（niri: grim）
# @category: runtime
# @usage: screenshot-output
# @effect: 按 XDG 图片目录生成整屏截图并通知
# @doc: niri.md
DE_LIB="${XDG_DATA_HOME:-@HOME@/.local/share}/hyprbuddy-os/lib/de.sh"
[ -r "$DE_LIB" ] || DE_LIB="$(dirname "$(readlink -f "$0")")/lib/de.sh"
. "$DE_LIB"
de_screenshot_output || { de_notify "截图失败" "当前桌面截图命令不可用"; exit 1; }
