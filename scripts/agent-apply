#!/usr/bin/env bash
# @command: agent-apply
# @summary: 改动唯一入口：求值 → 构建 → 打印需用户执行的 sudo 命令
# @category: workflow
# @usage: agent-apply [host]
# @effect: 运行 nix eval 与 nixos-rebuild build（不改系统）
# @doc: workflow.md
# agent 改动的唯一入口：改 models/hosts 后先验证求值，再构建，最后打印应用命令。
set -euo pipefail

# 不假设用户系统已开启 flakes 实验特性：NIX_CONFIG 对 nix 与
# nixos-rebuild 内部调用同时生效。
export NIX_CONFIG="experimental-features = nix-command flakes"

repo="${HYPRLAND_NIXOS_REPO:-$HOME/hyprland-nixos}"
host="${1:-$(hostname)}"

cd "$repo"

echo "==> host: $host"
git --no-pager diff --stat || true

echo "==> 求值"
nix eval --raw ".#nixosConfigurations.${host}.config.system.build.toplevel.drvPath" > /dev/null

echo "==> 构建"
nixos-rebuild build --flake ".#${host}"

echo
echo "构建通过。应用："
echo "  sudo nixos-rebuild switch --flake $repo#${host}"
