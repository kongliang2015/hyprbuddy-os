#!/usr/bin/env bash
# @command: wallpaper-next
# @summary: 循环切换 ~/Pictures/wallpapers 壁纸
# @category: runtime
# @usage: wallpaper-next
# @effect: 设置壁纸（niri: Noctalia 壁纸服务，经能力层 de_wallpaper_set）
# @doc: theming.md
# 循环切换 ~/Pictures/wallpapers 里的壁纸
dir="$HOME/Pictures/wallpapers"
state="${XDG_RUNTIME_DIR:-/tmp}/wallpaper.idx"
mkdir -p "$dir"
mapfile -t imgs < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' \) | sort)
[ "${#imgs[@]}" -eq 0 ] && exit 0
i=$(cat "$state" 2>/dev/null || echo -1)
i=$(( (i + 1) % ${#imgs[@]} ))
echo "$i" > "$state"
img="${imgs[$i]}"
DE_LIB="${XDG_DATA_HOME:-@HOME@/.local/share}/hyprland-nixos/lib/de.sh"
[ -r "$DE_LIB" ] || DE_LIB="$(dirname "$(readlink -f "$0")")/lib/de.sh"
. "$DE_LIB"

# 桌面差异由能力层处理
de_wallpaper_set "$img" || exit 0
