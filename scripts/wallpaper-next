#!/usr/bin/env bash
# @command: wallpaper-next
# @summary: 循环切换 ~/Pictures/wallpapers 壁纸
# @category: runtime
# @usage: wallpaper-next
# @effect: 通过 awww 设置壁纸
# @doc: theming.md
# 循环切换 ~/Pictures/wallpapers 里的壁纸
dir="$HOME/Pictures/wallpapers"
state="${XDG_RUNTIME_DIR:-/tmp}/wallpaper.idx"
mkdir -p "$dir"
mapfile -t imgs < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' \) | sort)
[ "${#imgs[@]}" -eq 0 ] && exit 0
i=$(cat "$state" 2>/dev/null || echo -1)
i=$(( (i + 1) % ${#imgs[@]} ))
echo "$i" > "$state"
img="${imgs[$i]}"
# nixpkgs 26.05 起 swww 更名 awww，做两者兼容
if command -v awww >/dev/null 2>&1; then
  wp=awww wpd=awww-daemon
elif command -v swww >/dev/null 2>&1; then
  wp=swww wpd=swww-daemon
else
  exit 0
fi
pgrep -f "$wpd" >/dev/null 2>&1 || {
  setsid "$wpd" >/dev/null 2>&1 < /dev/null &
  sleep 1
}
"$wp" img "$img" >/dev/null 2>&1
