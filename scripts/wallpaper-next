#!/usr/bin/env bash
# 循环切换 ~/Pictures/wallpapers 里的壁纸
dir="$HOME/Pictures/wallpapers"
state="${XDG_RUNTIME_DIR:-/tmp}/wallpaper.idx"
mkdir -p "$dir"
mapfile -t imgs < <(find "$dir" -maxdepth 1 -type f \( -iname '*.png' -o -iname '*.jpg' \) | sort)
[ "${#imgs[@]}" -eq 0 ] && exit 0
i=$(cat "$state" 2>/dev/null || echo -1)
i=$(( (i + 1) % ${#imgs[@]} ))
echo "$i" > "$state"
img="${imgs[$i]}"
hyprctl hyprpaper preload "$img" >/dev/null 2>&1
hyprctl hyprpaper wallpaper ",$img" >/dev/null 2>&1
